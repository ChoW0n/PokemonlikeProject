@using PokemonBattle.Services
@inject GameState State

@{
    int technicalMachineCount = State.TechnicalMachines
        .Where(machine => machine.Quantity > 0)
        .Sum(machine => machine.Quantity);
    // 같은 유산은 아이디별로 묶어 하나의 칩과 중첩 수로 표시한다.
    var groupedLegacies = State.ActiveLegacies
        .GroupBy(legacy => legacy.Id, StringComparer.Ordinal)
        .Select(group => new { Legacy = group.First(), Count = group.Count() })
        .ToList();
    bool hasInventory = groupedLegacies.Count > 0
        || technicalMachineCount > 0
        || State.UnreadMailboxCount > 0;
}

@if (hasInventory)
{
    @* 현재 런에서 확인할 수 있는 보유 현황만 작게 표시한다. *@
    <div class="run-inventory-strip" aria-label="현재 런 보유 현황">
        @if (groupedLegacies.Count > 0)
        {
            <div class="run-inventory-group">
                <span class="run-inventory-label">관록</span>
                @foreach (var groupedLegacy in groupedLegacies)
                {
                    <span class="run-inventory-legacy" title="@groupedLegacy.Legacy.Description">
                        @groupedLegacy.Legacy.Name@(groupedLegacy.Count > 1 ? $" ×{groupedLegacy.Count}" : "")
                    </span>
                }
            </div>
        }

        @if (technicalMachineCount > 0)
        {
            <span class="run-inventory-item">기술머신 @(technicalMachineCount)개</span>
        }

        @if (State.UnreadMailboxCount > 0)
        {
            <span class="run-inventory-item run-inventory-unread"
                  aria-label="@($"{State.UnreadMailboxCount}개 읽지 않은 우편")">
                새 우편 @State.UnreadMailboxCount
            </span>
        }
    </div>
}
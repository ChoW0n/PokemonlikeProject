@page "/select"
@implements IDisposable
@using PokemonBattle.Services
@using PokemonBattle.Models
@using PokemonBattle.Components
@inject GameState State
@inject UnlockService Unlocks
@inject NavigationManager Nav

<PageTitle>포켓몬 도감</PageTitle>

<main class="dex-page">
    <div class="pokedex-shell">
        <div class="pokedex-top">
            <div class="pokedex-lens"></div>
            <div class="pokedex-lights">
                <span class="light red"></span>
                <span class="light yellow"></span>
                <span class="light green"></span>
            </div>
        </div>

        <div class="pokedex-screen">
            @if (IsLoading || !string.IsNullOrWhiteSpace(LoadMessage))
            {
                <p class="form-message" role="status" aria-live="polite">
                    @(IsLoading ? "배틀 데이터를 불러오는 중..." : LoadMessage)
                </p>
                @if (!IsLoading && !string.IsNullOrWhiteSpace(LoadMessage))
                {
                    <button type="button" class="secondary-action" @onclick="LoadTeamAsync">다시 시도</button>
                }
            }
            @if (ConfiguringId == null)
            {
                <div class="screen-heading team-heading">
                    <div>
                        <p class="eyebrow">TEAM LOADOUT / STEP 1</p>
                        <h1 id="team-select-heading">팀 구성</h1>
                        <p class="intro">포켓몬을 선택해 팀을 만들고, 카드에서 기술·특성·도구를 구성하세요.</p>
                    </div>
                    <div class="flow-count" aria-label="@($"팀 슬롯 {TeamLoadouts.Count} / {Math.Min(UnlockedIds.Count, 6)}")">
                        <strong>@TeamLoadouts.Count</strong>
                        <span>/ @Math.Min(UnlockedIds.Count, 6) 슬롯</span>
                    </div>
                </div>
                <div class="flow-steps" aria-label="팀 구성 진행 단계">
                    <span class="is-active"><b>1</b> 팀 선택</span>
                    <span><b>2</b> 구성 확인</span>
                    <span><b>3</b> 배틀 시작</span>
                </div>
                <div class="team-status-bar" role="status" aria-live="polite">
                    <strong>@(TeamLoadouts.Count == 0 ? "팀을 시작해보세요" : $"{TeamLoadouts.Count}마리 선택됨")</strong>
                    <span>@(CanStart ? "배틀을 시작할 수 있습니다." : "카드를 눌러 1~6마리를 구성하세요.")</span>
                </div>
                <label class="visually-hidden" for="pokemon-search">포켓몬 이름 검색</label>
                 <input id="pokemon-search" class="dex-search" type="search"
                       placeholder="포켓몬 이름 검색..."
                        autocomplete="off" aria-controls="@(TotalMatchCount > 0 ? "pokemon-results" : null)"
                       value="@RawSearchText"
                       @oninput="OnSearchChanged" />

                 <button type="button" class="lock-toggle" aria-pressed="@(ShowLocked ? "true" : "false")" aria-controls="@(TotalMatchCount > 0 ? "pokemon-results" : null)" @onclick="() => ShowLocked = !ShowLocked">
                    @(ShowLocked ? "잠긴 포켓몬 숨기기" : "잠긴 포켓몬 보기")
                </button>

                <p class="collection-results team-results" role="status" aria-live="polite">
                    @(TotalMatchCount == 0
                        ? "조건에 맞는 포켓몬이 없습니다."
                        : $"{FilteredPokemon.Count} / {TotalMatchCount}마리 표시 중")
                </p>
                @if (TotalMatchCount == 0)
                {
                    <div class="empty-state list-empty" role="status">
                        <span class="empty-mark">⌕</span>
                        <strong>조건에 맞는 포켓몬이 없습니다.</strong>
                        <span>검색어를 바꾸거나 잠긴 포켓몬 보기를 켜보세요.</span>
                    </div>
                }
                else
                {
                    <div id="pokemon-results" class="dex-grid" role="group" aria-label="포켓몬 선택 목록">
                        @foreach (var entry in FilteredPokemon)
                        {
                            bool isUnlocked = UnlockedIds.Contains(entry.Key);
                            var existingInTeam = TeamLoadouts.FirstOrDefault(l => l.PokemonId == entry.Key);
                             <button type="button" class="dex-entry dex-entry-button @(existingInTeam != null ? "is-selected" : "") @(isUnlocked ? "" : "is-locked")"
                                 disabled="@(!isUnlocked)"
                                 aria-label="@($"{(isUnlocked ? entry.Value.Name : "잠긴 포켓몬")}, 도감 번호 {entry.Key}{(existingInTeam != null ? $", 현재 팀에 레벨 {existingInTeam.Level}" : "")}")"
                                 aria-pressed="@(existingInTeam != null ? "true" : "false")"
                                 @onclick="() => StartConfiguring(entry.Key, isUnlocked)">
                                <span class="dex-number">No.@entry.Key.ToString("D3") @(existingInTeam != null ? $"Lv.{existingInTeam.Level}" : "")</span>
                                <img src="@entry.Value.EffectiveImageUrl" alt="@entry.Value.Name" class="dex-sprite" />
                                <span class="dex-name">@(isUnlocked ? entry.Value.Name : "???")</span>
                                <span class="card-state @(existingInTeam != null ? "is-selected" : "")">
                                    @(existingInTeam != null ? $"팀 포함 · #{TeamLoadouts.IndexOf(existingInTeam) + 1}" : isUnlocked ? "구성하기" : "잠김")
                                </span>
                                @if (isUnlocked)
                                {
                                    <span class="dex-type-icons">
                                        <img src="@TypeIcons.GetUrl(entry.Value.Type1)" class="type-icon-img small" alt="@entry.Value.Type1" />
                                        @if (entry.Value.Type2 != null)
                                        {
                                            <img src="@TypeIcons.GetUrl(entry.Value.Type2.Value)" class="type-icon-img small" alt="@entry.Value.Type2" />
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="dex-type">잠김</span>
                                }
                            </button>
                        }
                    </div>
                }
                @if (TotalMatchCount > FilteredPokemon.Count)
                {
                    <button type="button" class="load-more-button" @onclick="ShowMorePokemon">
                        포켓몬 더 보기 (@FilteredPokemon.Count / @TotalMatchCount)
                    </button>
                }

                @if (TeamLoadouts.Count > 0)
                {
                    <p class="config-label">배틀 순서 (위쪽이 먼저 출전합니다)</p>
                    <div class="team-order-list" role="list" aria-label="배틀 출전 순서">
                        @for (int i = 0; i < TeamLoadouts.Count; i++)
                        {
                            int idx = i;
                            var data = PokemonDatabase.All[TeamLoadouts[idx].PokemonId];
                            <div class="team-order-card" role="listitem">
                                <div class="team-order-summary">
                                    <span class="dex-number">#@(idx + 1) · Lv.@TeamLoadouts[idx].Level</span>
                                    <img src="@data.EffectiveImageUrl" alt="@data.Name" class="team-order-sprite" />
                                    <span class="dex-name">@data.Name</span>
                                </div>
                                <div class="order-buttons">
                                     <button type="button" class="order-button" aria-label="@($"{data.Name} 팀 순서 위로 이동")" disabled="@(idx == 0)" @onclick="() => MoveOrderUp(idx)">↑</button>
                                     <button type="button" class="order-button" aria-label="@($"{data.Name} 팀 순서 아래로 이동")" disabled="@(idx == TeamLoadouts.Count - 1)" @onclick="() => MoveOrderDown(idx)">↓</button>
                                     <button type="button" class="order-button remove-btn" aria-label="@($"{data.Name} 팀에서 제거")" @onclick="() => RemoveFromTeam(idx)">✕</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <p class="config-label">저장된 프리셋</p>
                <label class="visually-hidden" for="preset-name">프리셋 이름</label>
                <div class="preset-row">
                    <input id="preset-name" class="dex-search" placeholder="프리셋 이름" maxlength="80" value="@PresetName" @oninput="OnPresetNameChanged" />
                    <button type="button" disabled="@(IsOperationBusy || TeamLoadouts.Count == 0 || string.IsNullOrWhiteSpace(PresetName))" @onclick="SaveCurrentPreset">@(IsOperationBusy ? "처리 중..." : "저장")</button>
                </div>
                 <p class="form-message @(PresetMessageIsError ? "is-error" : "is-success")"
                    role="@(PresetMessageIsError ? "alert" : "status")"
                    aria-live="@(PresetMessageIsError ? "assertive" : "polite")">@PresetMessage</p>
                @if (PresetNames.Count == 0)
                {
                    <p class="preset-empty">저장된 프리셋이 없습니다.</p>
                }
                else
                {
                    <div class="preset-list" role="list" aria-label="저장된 프리셋 목록">
                        @foreach (var name in PresetNames)
                        {
                            <div class="preset-entry" role="listitem">
                                <span class="preset-name" title="@name">PRESET · @name</span>
                                <div class="preset-actions">
                                    <button type="button" class="preset-action" disabled="@IsOperationBusy" aria-label="@($"{name} 프리셋 불러오기")" @onclick="() => LoadPresetByName(name)">불러오기</button>
                                    <button type="button" class="preset-action preset-delete" disabled="@IsOperationBusy" aria-label="@($"{name} 프리셋 삭제")" @onclick="() => DeletePresetByName(name)">삭제</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                var picked = PokemonDatabase.All[ConfiguringId.Value];
                <div class="screen-heading detail-heading">
                    <div>
                        <p class="eyebrow">TEAM LOADOUT / STEP 2</p>
                         <h1 id="team-config-heading">@picked.Name 구성</h1>
                        <p class="intro">필수 조건은 기술 1개 이상입니다. 항목을 눌러 설명을 확인한 뒤 선택하세요.</p>
                    </div>
                    <span class="detail-state">@(TeamLoadouts.Any(l => l.PokemonId == ConfiguringId.Value) ? "팀 구성 수정" : "새 팀원")</span>
                </div>
                <div class="flow-steps" aria-label="팀 구성 진행 단계">
                    <span class="is-complete"><b>1</b> 팀 선택</span>
                    <span class="is-active"><b>2</b> 구성 확인</span>
                    <span><b>3</b> 배틀 시작</span>
                </div>
                <div class="dex-detail">
                    <div class="dex-detail-header">
                        <strong>@picked.Name</strong>
                        <span class="dex-detail-level">Lv.@DraftLevel</span>
                        <div class="hud-types">
                            <img src="@TypeIcons.GetUrl(picked.Type1)" class="type-icon-img" alt="@picked.Type1" />
                            @if (picked.Type2 != null)
                            {
                                <img src="@TypeIcons.GetUrl(picked.Type2.Value)" class="type-icon-img" alt="@picked.Type2" />
                            }
                        </div>
                    </div>
                    <div class="gauge-group">
                        <GaugeBar Label="HP" Percent="@StatBarHelper.StatPercent(picked.BaseHp)" ColorClass="@StatBarHelper.StatColor(picked.BaseHp)" DisplayText="@picked.BaseHp.ToString()" />
                        <GaugeBar Label="공격" Percent="@StatBarHelper.StatPercent(picked.BaseAtk)" ColorClass="@StatBarHelper.StatColor(picked.BaseAtk)" DisplayText="@picked.BaseAtk.ToString()" />
                        <GaugeBar Label="방어" Percent="@StatBarHelper.StatPercent(picked.BaseDef)" ColorClass="@StatBarHelper.StatColor(picked.BaseDef)" DisplayText="@picked.BaseDef.ToString()" />
                        <GaugeBar Label="특공" Percent="@StatBarHelper.StatPercent(picked.BaseSpAtk)" ColorClass="@StatBarHelper.StatColor(picked.BaseSpAtk)" DisplayText="@picked.BaseSpAtk.ToString()" />
                        <GaugeBar Label="특방" Percent="@StatBarHelper.StatPercent(picked.BaseSpDef)" ColorClass="@StatBarHelper.StatColor(picked.BaseSpDef)" DisplayText="@picked.BaseSpDef.ToString()" />
                        <GaugeBar Label="속도" Percent="@StatBarHelper.StatPercent(picked.BaseSpd)" ColorClass="@StatBarHelper.StatColor(picked.BaseSpd)" DisplayText="@picked.BaseSpd.ToString()" />
                    </div>
                </div>

                <p class="config-label">기술 선택 (@DraftMoves.Count / 4) — 눌러서 자세히 볼 수 있습니다</p>
                @if (State.TechnicalMachines.Any(machine => machine.Quantity > 0))
                {
                    <p class="config-label">보유 기술머신과 호환되는 기술은 기술 목록에 TM으로 표시됩니다.</p>
                }
                <div class="dex-grid">
                @foreach (var moveKey in CompatibleMoveKeys(picked))
                    {
                        var move = MoveDatabase.All[moveKey];
                        <button type="button" class="dex-entry dex-entry-button move-tile @(DraftMoves.Contains(moveKey) ? "is-selected" : string.Empty) @(ViewingMoveKey == moveKey ? "is-viewing" : "")"
                             aria-label="@($"{move.Name}, {(move.IsStatus ? "변화기" : "공격기")}{(DraftMoves.Contains(moveKey) ? ", 선택됨" : "")}")"
                             aria-pressed="@(DraftMoves.Contains(moveKey) ? "true" : "false")"
                             aria-expanded="@(ViewingMoveKey == moveKey ? "true" : "false")"
                             aria-controls="@(ViewingMoveKey == moveKey ? "selected-move-info" : null)"
                             title="클릭하면 기술을 선택하고 상세 정보를 표시합니다."
                             @onclick="() => SelectMoveFromCard(moveKey)"
                             @ondblclick="() => SelectMoveFromCard(moveKey)"
                             @ondblclick:preventDefault>
                            <span class="type-dot" style="background:@TypeColors.GetHex(move.Type)"></span>
                             <span class="dex-name">@move.Name @(move.Priority > 0 ? "우선" : "") @(IsTechnicalMachineMove(picked, moveKey) ? "· TM" : "") @(IsRunStolenMove(picked, moveKey) ? "· 강탈" : "")</span>
                             <span class="card-state @(DraftMoves.Contains(moveKey) ? "is-selected" : "")">@(DraftMoves.Contains(moveKey) ? "선택됨" : ViewingMoveKey == moveKey ? "상세 확인 중" : "선택하기")</span>
                            <span class="dex-type">@(move.IsStatus ? "변화기" : "공격기")</span>
                        </button>
                    }
                </div>
                @if (ViewingMoveKey != null)
                {
                    var vmove = MoveDatabase.All[ViewingMoveKey];
                     <div id="selected-move-info" class="info-panel" role="region" aria-label="@($"{vmove.Name} 상세 정보")">
                        @if (!vmove.IsStatus)
                        {
                            <GaugeBar Label="위력" Percent="@StatBarHelper.PowerPercent(vmove.Power)" ColorClass="@StatBarHelper.PowerColor(vmove.Power)" DisplayText="@vmove.Power.ToString()" />
                        }
                        <GaugeBar Label="명중" Percent="@(vmove.AlwaysHits ? 100 : StatBarHelper.AccuracyPercent(vmove.Accuracy))" ColorClass="@(vmove.AlwaysHits ? "gauge-vhigh" : StatBarHelper.AccuracyColor(vmove.Accuracy))" DisplayText="@(vmove.AlwaysHits ? "필중" : $"{vmove.Accuracy}%")" />
                        <p class="info-desc">@(string.IsNullOrWhiteSpace(vmove.Description) ? "설명 없음" : vmove.Description)</p>
                             <button type="button" class="info-select-btn @(DraftMoves.Contains(ViewingMoveKey) ? "is-active" : "")" aria-pressed="@(DraftMoves.Contains(ViewingMoveKey) ? "true" : "false")" @onclick="() => ToggleMove(ViewingMoveKey)">
                            @(DraftMoves.Contains(ViewingMoveKey) ? "선택 해제" : "이 기술 선택")
                        </button>
                    </div>
                }

                <p class="config-label">특성 선택 — 눌러서 설명을 확인할 수 있습니다</p>
                <div class="dex-grid">
                    @foreach (var ability in picked.AbilityNames)
                    {
                        <button type="button" class="dex-entry dex-entry-button @(DraftAbility == ability ? "is-selected" : string.Empty) @(ViewingAbility == ability ? "is-viewing" : "")"
                             aria-label="@($"{ability}{(DraftAbility == ability ? ", 선택됨" : "")}, 상세 보기")"
                             aria-pressed="@(DraftAbility == ability ? "true" : "false")"
                             aria-expanded="@(ViewingAbility == ability ? "true" : "false")"
                             aria-controls="@(ViewingAbility == ability ? "selected-ability-info" : null)"
                             title="클릭하면 특성을 장착하고 상세 정보를 표시합니다."
                             @onclick="() => SelectAbilityFromCard(ability)"
                             @ondblclick="() => SelectAbilityFromCard(ability)"
                             @ondblclick:preventDefault>
                            <span class="dex-name">@ability</span>
                              <span class="card-state @(DraftAbility == ability ? "is-selected" : "")">@(DraftAbility == ability ? "선택됨" : ViewingAbility == ability ? "상세 확인 중" : "상세 보기")</span>
                            <span class="dex-type">@(AbilityDatabase.IsImplemented(ability)
                                ? $"전투 적용 · {AbilityDatabase.GetImplementationGroup(ability)}"
                                : $"설명만 제공 · {AbilityDatabase.GetImplementationGroup(ability)}")</span>
                        </button>
                    }
                </div>
                @if (ViewingAbility != null)
                {
                    string desc = AbilityDatabase.All.TryGetValue(ViewingAbility, out var info) ? info.Description : "";
                     <div id="selected-ability-info" class="info-panel" role="region" aria-label="@($"{ViewingAbility} 상세 정보")">
                        <p class="info-desc"><strong>@(AbilityDatabase.IsImplemented(ViewingAbility)
                            ? $"전투에서 실제 적용됩니다. 분류: {AbilityDatabase.GetImplementationGroup(ViewingAbility)}"
                            : $"현재는 설명만 제공되며 전투 효과는 적용되지 않습니다. 우선순위 그룹: {AbilityDatabase.GetImplementationGroup(ViewingAbility)}")</strong></p>
                        <p class="info-desc">@(string.IsNullOrWhiteSpace(desc) ? "설명 없음" : desc)</p>
                        <button type="button" class="info-select-btn @(DraftAbility == ViewingAbility ? "is-active" : "")" aria-pressed="@(DraftAbility == ViewingAbility ? "true" : "false")" @onclick="() => DraftAbility = ViewingAbility">
                            @(DraftAbility == ViewingAbility ? "선택됨" : "이 특성 선택")
                        </button>
                    </div>
                }

                <p class="config-label">도구 선택 — 눌러서 설명을 확인할 수 있습니다</p>
                <label class="visually-hidden" for="item-search">도구 이름 검색</label>
                <input id="item-search" class="dex-search" placeholder="도구 이름 검색..." value="@ItemSearchText" @oninput="OnItemSearchChanged" />
                var filteredItems = FilteredItems(picked.Name);
                @if (filteredItems.Count == 0)
                {
                    <div class="empty-state compact-empty" role="status">검색 조건에 맞는 도구가 없습니다.</div>
                }
                else
                {
                    <div class="dex-grid">
                        @foreach (var item in filteredItems)
                        {
                        <button type="button" class="dex-entry dex-entry-button @(DraftItem == item.Name ? "is-selected" : string.Empty) @(ViewingItemName == item.Name ? "is-viewing" : "")"
                                 aria-label="@($"{item.Name}{(DraftItem == item.Name ? ", 선택됨" : "")}")"
                                 aria-pressed="@(DraftItem == item.Name ? "true" : "false")"
                                 aria-expanded="@(ViewingItemName == item.Name ? "true" : "false")"
                                 aria-controls="@(ViewingItemName == item.Name ? "selected-item-info" : null)"
                                 title="클릭하면 도구를 장착하고 상세 정보를 표시합니다."
                                 @onclick="() => SelectItemFromCard(item.Name)"
                                 @ondblclick="() => SelectItemFromCard(item.Name)"
                                 @ondblclick:preventDefault>
                                @if (item.IconUrl != null)
                                {
                                    <img src="@item.IconUrl" alt="@item.Name" class="item-icon" />
                                }
                                <span class="dex-name">@item.Name</span>
                                <span class="card-state @(DraftItem == item.Name ? "is-selected" : "")">@(DraftItem == item.Name ? "선택됨" : ViewingItemName == item.Name ? "상세 확인 중" : "선택하기")</span>
                            </button>
                        }
                    </div>
                }
                @if (ViewingItemName != null)
                {
                    var vitem = ItemDatabase.GetAvailableItems(picked.Name).First(i => i.Name == ViewingItemName);
                    <div id="selected-item-info" class="info-panel" role="region" aria-label="@($"{vitem.Name} 상세 정보")">
                        <p class="info-desc">@vitem.Description</p>
                         <button type="button" class="info-select-btn @(DraftItem == ViewingItemName ? "is-active" : "")" aria-pressed="@(DraftItem == ViewingItemName ? "true" : "false")" @onclick="() => DraftItem = ViewingItemName">
                            @(DraftItem == ViewingItemName ? "선택됨" : "이 도구 선택")
                        </button>
                    </div>
                }

                <div class="pokedex-footer">
                    <div class="footer-copy">
                        <strong>@(DraftMoves.Count == 0 ? "기술을 1개 이상 선택하세요" : $"기술 {DraftMoves.Count}개 선택됨")</strong>
                        <span>특성: @(string.IsNullOrWhiteSpace(DraftAbility) ? "미선택" : DraftAbility) · 도구: @DraftItem</span>
                    </div>
                    <div class="footer-actions">
                        <button type="button" @onclick="CancelConfiguring">취소</button>
                        <button type="button" disabled="@(DraftMoves.Count == 0)" @onclick="ConfirmConfiguring">이 구성으로 팀에 추가</button>
                    </div>
                </div>
            }
        </div>

        @if (ConfiguringId == null)
        {
            <div class="pokedex-footer">
                <div class="footer-copy">
                    <strong>@(CanStart ? "배틀 준비 완료" : "팀 구성을 계속하세요")</strong>
                    <span>팀 구성: @TeamLoadouts.Count / @Math.Min(UnlockedIds.Count, 6)</span>
                </div>
                <button type="button" disabled="@(!CanStart || IsOperationBusy)" @onclick="ConfirmTeam">
                    @(IsOperationBusy ? "저장 중..." : "이 팀으로 배틀 시작")
                </button>
            </div>
        }
    </div>
</main>

@code {
    private string RawSearchText = "";
    private string SearchText = "";
    private CancellationTokenSource? _searchDebounce;
    private bool ShowLocked = false;
    private int VisiblePokemonCount = 60;
    private bool IsOperationBusy;
    private bool IsLoading;
    private string LoadMessage = "";

    private string ItemSearchText = "";
    private string PresetName = "";
    private string PresetMessage = "";
    private bool PresetMessageIsError;
    private List<PokemonLoadout> TeamLoadouts = new();
    private List<string> PresetNames = new();
    private HashSet<int> UnlockedIds = new();

    private int? ConfiguringId;
    private List<string> DraftMoves = new();
    private string DraftAbility = "";
    private string DraftItem = "없음";
    private int DraftLevel = 1;

    private string? ViewingMoveKey;
    private string? ViewingAbility;
    private string? ViewingItemName;

    private bool CanStart => TeamLoadouts.Count is >= 1 and <= 6;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamAsync();
    }

    private async Task LoadTeamAsync()
    {
        if (IsLoading) return;
        IsLoading = true;
        LoadMessage = "";
        try
        {
            UnlockedIds = await Unlocks.GetUnlockedIds();
            await State.LoadRunForCurrentUser();

            if (State.PlayerLoadouts.Count > 0)
            {
                TeamLoadouts = State.PlayerLoadouts.Select(l =>
                {
                    var validKeys = PokemonDatabase.All.ContainsKey(l.PokemonId)
                        ? PokemonDatabase.All[l.PokemonId].MoveNames.ToHashSet()
                        : new HashSet<string>();

                    return new PokemonLoadout
                    {
                        PokemonId = l.PokemonId,
                        ChosenMoveNames = l.ChosenMoveNames.Where(m => validKeys.Contains(m)).ToList(),
                        ChosenAbility = l.ChosenAbility,
                        ChosenItem = l.ChosenItem,
                        Level = l.Level
                    };
                }).ToList();
            }

            TeamLoadouts = TeamLoadoutRules.NormalizeUniqueItems(TeamLoadouts);
            await RefreshPresetNames();
        }
        catch
        {
            LoadMessage = "배틀 데이터를 불러오지 못했습니다. 다시 시도해주세요.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<KeyValuePair<int, PokemonData>> MatchingPokemon =>
        PokemonDatabase.All
            .Where(p => SearchText == "" || p.Value.Name.Contains(SearchText, StringComparison.CurrentCultureIgnoreCase)
                || p.Value.EnglishName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || p.Key.ToString() == SearchText.Trim())
            .Where(p => ShowLocked || UnlockedIds.Contains(p.Key))
            .OrderBy(p => p.Key)
            .ToList();

    private List<KeyValuePair<int, PokemonData>> FilteredPokemon =>
        MatchingPokemon.Take(VisiblePokemonCount).ToList();

    private int TotalMatchCount => MatchingPokemon.Count;

    private List<Item> FilteredItems(string pokemonName)
    {
        var unavailableItems = TeamLoadoutRules.UsedItems(TeamLoadouts, ConfiguringId);
        return ItemDatabase.GetAvailableItems(pokemonName)
            .Where(i => i.Name.Contains(ItemSearchText))
            .Where(i => i.Name == TeamLoadoutRules.NoItem || !unavailableItems.Contains(i.Name))
            .ToList();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        RawSearchText = e.Value?.ToString() ?? "";

        _searchDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        _searchDebounce = cts;

        try
        {
            await Task.Delay(250, cts.Token);
            SearchText = RawSearchText;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void OnItemSearchChanged(ChangeEventArgs e)
    {
        ItemSearchText = e.Value?.ToString() ?? "";
    }

    private void ShowMorePokemon() =>
        VisiblePokemonCount = Math.Min(VisiblePokemonCount + 60, TotalMatchCount);

    private void OnPresetNameChanged(ChangeEventArgs e)
    {
        PresetName = e.Value?.ToString() ?? "";
    }

    private void StartConfiguring(int id, bool isUnlocked)
    {
        if (!isUnlocked) return;

        int maxTeamSize = Math.Min(UnlockedIds.Count, 6);
        if (TeamLoadouts.Count >= maxTeamSize && !TeamLoadouts.Any(l => l.PokemonId == id)) return;

        ConfiguringId = id;
        ItemSearchText = "";
        ViewingMoveKey = null;
        ViewingAbility = null;
        ViewingItemName = null;

        var existing = TeamLoadouts.FirstOrDefault(l => l.PokemonId == id);

        var validKeys = CompatibleMoveKeys(PokemonDatabase.All[id]).ToHashSet();
        DraftMoves = existing != null
            ? existing.ChosenMoveNames.Where(m => validKeys.Contains(m)).ToList()
            : new List<string>();

        DraftAbility = existing?.ChosenAbility ?? PokemonDatabase.All[id].AbilityNames.FirstOrDefault() ?? "";
        DraftItem = existing?.ChosenItem ?? "없음";
        DraftLevel = existing?.Level ?? State.CurrentRunLevel;
    }

    private void SelectMoveFromCard(string moveKey)
    {
        ViewingMoveKey = moveKey;
        if (!DraftMoves.Contains(moveKey) && DraftMoves.Count < 4)
        {
            DraftMoves.Add(moveKey);
        }
    }

    private void SelectAbilityFromCard(string ability)
    {
        ViewingAbility = ability;
        DraftAbility = ability;
    }

    private void SelectItemFromCard(string itemName)
    {
        ViewingItemName = itemName;
        DraftItem = itemName;
    }

    private void ToggleMove(string moveKey)
    {
        if (DraftMoves.Contains(moveKey))
        {
            if (ConfiguringId != null
                && State.IsRunStolenMove(ConfiguringId.Value, moveKey))
            {
                return;
            }
            DraftMoves.Remove(moveKey);
        }
        else if (DraftMoves.Count < 4)
        {
            DraftMoves.Add(moveKey);
        }
    }

    private void CancelConfiguring()
    {
        ConfiguringId = null;
    }

    private async Task ConfirmConfiguring()
    {
        if (ConfiguringId == null) return;

        if (!TeamLoadoutRules.CanUseItem(TeamLoadouts, ConfiguringId.Value, DraftItem))
        {
            PresetMessage = "이미 다른 팀원이 사용 중인 도구입니다. 다른 도구를 선택해주세요.";
            PresetMessageIsError = true;
            return;
        }

        var existing = TeamLoadouts.FirstOrDefault(l => l.PokemonId == ConfiguringId.Value);
        var availableMachineMoves = State.TechnicalMachines
            .Where(machine => machine.Quantity > 0)
            .Select(machine => machine.MoveKey)
            .ToHashSet(StringComparer.Ordinal);
        var newlyLearnedMachineMoves = DraftMoves
            .Where(availableMachineMoves.Contains)
            .Where(moveKey => existing == null || !existing.ChosenMoveNames.Contains(moveKey))
            .ToList();
        foreach (var moveKey in newlyLearnedMachineMoves)
        {
            if (!await State.TryLearnTechnicalMachineAsync(moveKey))
            {
                PresetMessage = "기술머신 보유 수량이 부족합니다. 다시 선택해주세요.";
                PresetMessageIsError = true;
                return;
            }
        }

        TeamLoadouts.RemoveAll(l => l.PokemonId == ConfiguringId.Value);
        TeamLoadouts.Add(new PokemonLoadout
        {
            PokemonId = ConfiguringId.Value,
            ChosenMoveNames = new List<string>(DraftMoves),
            ChosenAbility = DraftAbility,
            ChosenItem = DraftItem,
            Level = DraftLevel
        });

        ConfiguringId = null;
    }

    private void MoveOrderUp(int idx)
    {
        if (idx <= 0) return;
        (TeamLoadouts[idx - 1], TeamLoadouts[idx]) = (TeamLoadouts[idx], TeamLoadouts[idx - 1]);
    }

    private void MoveOrderDown(int idx)
    {
        if (idx >= TeamLoadouts.Count - 1) return;
        (TeamLoadouts[idx + 1], TeamLoadouts[idx]) = (TeamLoadouts[idx], TeamLoadouts[idx + 1]);
    }

    private void RemoveFromTeam(int idx)
    {
        TeamLoadouts.RemoveAt(idx);
    }

    private async Task SaveCurrentPreset()
    {
        if (IsOperationBusy || TeamLoadouts.Count == 0 || string.IsNullOrWhiteSpace(PresetName)) return;

        string name = PresetName.Trim();
        if (name.Length == 0) return;

        IsOperationBusy = true;
        try
        {
            bool saved = await State.SavePreset(name, TeamLoadouts);
            PresetMessage = saved
                ? $"'{name}' 프리셋을 저장했습니다."
                : "프리셋을 저장하지 못했습니다. 로그인 상태를 확인해주세요.";
            PresetMessageIsError = !saved;
            if (saved)
            {
                PresetName = "";
                await RefreshPresetNames();
            }
        }
        catch
        {
            PresetMessage = "프리셋 저장 중 문제가 발생했습니다. 다시 시도해주세요.";
            PresetMessageIsError = true;
        }
        finally
        {
            IsOperationBusy = false;
        }
    }

    private async Task RefreshPresetNames()
    {
        PresetNames = await State.ListPresetNames();
    }

    private async Task LoadPresetByName(string name)
    {
        if (IsOperationBusy) return;
        IsOperationBusy = true;
        var currentTeam = TeamLoadouts;
        try
        {
            var loaded = await State.LoadPreset(name, currentTeam);
            if (loaded == null)
            {
                PresetMessage = $"'{name}' 프리셋을 찾을 수 없습니다.";
                PresetMessageIsError = true;
                await RefreshPresetNames();
                return;
            }

            var currentLevels = currentTeam
                .GroupBy(loadout => loadout.PokemonId)
                .ToDictionary(group => group.Key, group => group.First().Level);

            TeamLoadouts = TeamLoadoutRules.NormalizeUniqueItems(loaded)
                .Where(l => UnlockedIds.Contains(l.PokemonId) && PokemonDatabase.All.ContainsKey(l.PokemonId))
                .Take(Math.Min(UnlockedIds.Count, 6))
                .Select(l =>
                {
                    var validKeys = PokemonDatabase.All[l.PokemonId].MoveNames.ToHashSet();
                    return new PokemonLoadout
                    {
                        PokemonId = l.PokemonId,
                        ChosenMoveNames = l.ChosenMoveNames.Where(m => validKeys.Contains(m)).ToList(),
                        ChosenAbility = l.ChosenAbility,
                        ChosenItem = l.ChosenItem,
                        Level = currentLevels.TryGetValue(l.PokemonId, out var level)
                            ? level
                            : State.CurrentRunLevel
                    };
                }).ToList();

            TeamLoadouts = TeamLoadoutRules.NormalizeUniqueItems(TeamLoadouts);
            PresetMessage = $"'{name}' 프리셋을 불러왔습니다.";
            PresetMessageIsError = false;
        }
        catch
        {
            PresetMessage = "프리셋을 불러오는 중 문제가 발생했습니다. 다시 시도해주세요.";
            PresetMessageIsError = true;
        }
        finally
        {
            IsOperationBusy = false;
        }
    }

    private async Task DeletePresetByName(string name)
    {
        if (IsOperationBusy) return;
        IsOperationBusy = true;
        try
        {
            bool deleted = await State.DeletePreset(name);
            PresetMessage = deleted
                ? $"'{name}' 프리셋을 삭제했습니다."
                : $"'{name}' 프리셋을 찾을 수 없습니다.";
            PresetMessageIsError = !deleted;
            await RefreshPresetNames();
        }
        catch
        {
            PresetMessage = "프리셋 삭제 중 문제가 발생했습니다. 다시 시도해주세요.";
            PresetMessageIsError = true;
        }
        finally
        {
            IsOperationBusy = false;
        }
    }

    private async Task ConfirmTeam()
    {
        if (!CanStart || IsOperationBusy) return;

        IsOperationBusy = true;
        try
        {
            await State.SetPlayerLoadouts(TeamLoadouts);
            State.BeginBattle();
            State.GoTo(GameScreen.Battle);
            Nav.NavigateTo("/battle");
        }
        catch
        {
            PresetMessage = "팀 저장 중 문제가 발생했습니다. 다시 시도해주세요.";
            PresetMessageIsError = true;
        }
        finally
        {
            IsOperationBusy = false;
        }
    }

    public void Dispose()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }

    private List<string> CompatibleMoveKeys(PokemonData data) =>
        data.MoveNames
            .Concat(State.TechnicalMachineMovesFor(
                PokemonDatabase.All.First(entry => ReferenceEquals(entry.Value, data)).Key))
            .Concat(State.RunStolenMoveKeysFor(
                PokemonDatabase.All.First(entry => ReferenceEquals(entry.Value, data)).Key))
            .Concat(TeamLoadouts
                .FirstOrDefault(loadout => PokemonDatabase.All.TryGetValue(loadout.PokemonId, out var owned)
                    && ReferenceEquals(owned, data))
                ?.ChosenMoveNames ?? Enumerable.Empty<string>())
            .Where(MoveDatabase.All.ContainsKey)
            .Distinct(StringComparer.Ordinal)
            .ToList();

    private bool IsTechnicalMachineMove(PokemonData data, string moveKey) =>
        State.TechnicalMachines.Any(machine =>
            machine.MoveKey == moveKey && machine.Quantity > 0);

    private bool IsRunStolenMove(PokemonData data, string moveKey) =>
        State.IsRunStolenMove(
            PokemonDatabase.All.First(entry => ReferenceEquals(entry.Value, data)).Key,
            moveKey);
}

@page "/"
@page "/battle"
@using PokemonBattle.Models

<PageTitle>포켓몬 배틀</PageTitle>

<main class="battle-page">
    <header class="battle-header">
        <div>
            <p class="eyebrow">BATTLE LAB / SERVER SESSION</p>
            <h1>포켓몬 배틀</h1>
            <p class="intro">순수 C#과 Blazor Server로 만드는 확장형 배틀 화면입니다.</p>
        </div>
        <div class="header-status">
            <span class="status-dot"></span>
            <span>연결됨</span>
        </div>
    </header>

    <section class="battle-arena" aria-label="배틀 상태">
        <div class="arena-grid">
            <article class="fighter-card player-card">
                <div class="fighter-topline">
                    <span class="fighter-label">PLAYER</span>
                    <span class="level-label">LV. 01</span>
                </div>
                <div class="fighter-placeholder" aria-hidden="true">?</div>
                <h2>@Hero.Data.Name</h2>
                <p class="placeholder-copy">속성: @Hero.Data.Type</p>
                <div class="health-row">
                    <span>HP</span>
                    <div class="health-track">
                        <span class="health-fill player-health" style="width:@HeroHpPercent%"></span>
                    </div>
                    <strong>@Hero.CurrentHp / @Hero.Data.BaseHp</strong>
                </div>
            </article>

            <div class="versus-mark" aria-hidden="true">VS</div>

            <article class="fighter-card opponent-card">
                <div class="fighter-topline">
                    <span class="fighter-label">OPPONENT</span>
                    <span class="level-label">LV. 01</span>
                </div>
                <div class="fighter-placeholder opponent-placeholder" aria-hidden="true">?</div>
                <h2>@Enemy.Data.Name</h2>
                <p class="placeholder-copy">속성: @Enemy.Data.Type</p>
                <div class="health-row">
                    <span>HP</span>
                    <div class="health-track">
                        <span class="health-fill opponent-health" style="width:@EnemyHpPercent%"></span>
                    </div>
                    <strong>@Enemy.CurrentHp / @Enemy.Data.BaseHp</strong>
                </div>
            </article>
        </div>
    </section>

    <section class="command-panel" aria-label="배틀 커맨드">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">TURN @Turn</p>
                <h2>기술 선택</h2>
            </div>
            <span class="selection-pill">@SelectedMove</span>
        </div>

        <div class="move-grid">
            @foreach (var move in MoveSlots)
            {
                <button type="button"
                        class="move-button @(SelectedMove == move ? "is-selected" : string.Empty)"
                        disabled="@(Enemy.IsFainted || Hero.IsFainted)"
                        @onclick="() => SelectMove(move)">
                    <span class="move-index">@((Array.IndexOf(MoveSlots, move) + 1).ToString("D2"))</span>
                    <span>@move</span>
                    <span class="move-arrow" aria-hidden="true">→</span>
                </button>
            }
        </div>

        <div class="battle-log" role="status" aria-live="polite">
            <span class="log-marker"></span>
            <p>@BattleMessage</p>
        </div>

        <div class="command-footer">
            <p>기술과 포켓몬 데이터는 각 역할별 파일에 직접 추가할 수 있습니다.</p>
            <button type="button" class="reset-button" @onclick="ResetBattle">상태 초기화</button>
        </div>
    </section>
</main>

@code {
    //임시 기술 슬롯 이름 (다음 단계에서 IMoveEffect 기반 실제 기술로 교체 예정)
    private readonly string[] MoveSlots =
    [
        "기술 슬롯 1",
        "기술 슬롯 2",
        "기술 슬롯 3",
        "기술 슬롯 4"
    ];

    //배틀에 참가하는 두 포켓몬 인스턴스
    private Pokemon Hero = new Pokemon(PokemonDatabase.All[1]);
    private Pokemon Enemy = new Pokemon(PokemonDatabase.All[4]);

    private int Turn;
    private string SelectedMove = "선택된 기술 없음";
    private string BattleMessage = "기술 슬롯을 눌러 배틀 커맨드를 선택해 보세요.";

    //HP 바 너비(%) 계산용 프로퍼티
    private int HeroHpPercent => (int)(100.0 * Hero.CurrentHp / Hero.Data.BaseHp);
    private int EnemyHpPercent => (int)(100.0 * Enemy.CurrentHp / Enemy.Data.BaseHp);

    private void SelectMove(string move) //기술 버튼 클릭 시 실제 데미지 계산 및 반영
    {
        SelectedMove = move;
        Turn++;

        //지금은 4개 슬롯 전부 임시로 플레이어 기본 공격력만큼 데미지 (다음 단계에서 슬롯별 다른 기술로 교체)
        Enemy.TakeDamage(Hero.Data.BaseAtk, Hero.Data.Type);

        if (Enemy.IsFainted)
        {
            BattleMessage = $"{Enemy.Data.Name} 기절! {Hero.Data.Name} 승리!";
        }
        else
        {
            BattleMessage = $"{move}을(를) 사용해 {Enemy.Data.Name}에게 데미지를 입혔습니다.";
        }
    }

    private void ResetBattle() //초기화 버튼: 포켓몬 인스턴스와 배틀 상태 전부 리셋
    {
        Hero = new Pokemon(PokemonDatabase.All[1]);
        Enemy = new Pokemon(PokemonDatabase.All[4]);
        Turn = 0;
        SelectedMove = "선택된 기술 없음";
        BattleMessage = "배틀 상태를 초기화했습니다. 기술 슬롯을 눌러 시작해 보세요.";
    }
}
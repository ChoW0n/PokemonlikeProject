    private async Task<bool> RunTurn(
        Pokemon attacker,
        Pokemon defender,
        string? moveKey,
        bool attackerIsHero,
        bool attackerMovedFirst)
    {
        if (!attackerIsHero && moveKey != null)
        {
            State.RecordEnemyMoveUsed(PokemonDatabase.All
                .First(entry => ReferenceEquals(entry.Value, attacker.Data)).Key, moveKey);
        }
        var result = await Rules.TakeTurnAsync(
            attacker,
            defender,
            moveKey,
            attackerIsHero,
            PlayBattleEvent,
            attackerMovedFirst);

        if (result.FaintedPokemon == null && result.ForcedSwitchPokemon != null)
        {
            return await HandleForcedSwitch(ReferenceEquals(result.ForcedSwitchPokemon, Hero));
        }
        if (result.FaintedPokemon == null) return false;

        if (result.OtherFaintedPokemon != null)
        {
            // 더블 KO(예: 대폭발/자폭으로 공격자·방어자 동시 기절).
            // 방어자는 데미지로 쓰러진 것이므로 안내 메시지 필요. 상대 쪽을 먼저
            // 처리(자동 교체/승리 판정)한 뒤 내 쪽(교체 선택/패배 판정)을 처리한다.
            await ShowMessage(FaintLine(defender));
            var enemyFainted = attackerIsHero ? defender : attacker;
            var heroFainted = attackerIsHero ? attacker : defender;
            
            await HandleFaint(enemyFainted, false);
            if (EnemyTeam.All(p => p.IsFainted)) return true; // 승리 처리 후 이미 이동됨
            
            return await HandleFaint(heroFainted, true);
        }

        bool faintedIsAttacker = ReferenceEquals(result.FaintedPokemon, attacker);
        if (!faintedIsAttacker)
        {
            await ShowMessage(FaintLine(result.FaintedPokemon));
        }

        bool stoppedAfterFaint = await HandleFaint(
            result.FaintedPokemon,
            faintedIsAttacker ? attackerIsHero : !attackerIsHero);

        if (!faintedIsAttacker
            && attackerIsHero
            && ReferenceEquals(result.ForcedSwitchPokemon, attacker))
        {
            // 상대 기절 처리를 먼저 끝낸 뒤 유턴 사용자의 교체 선택을 이어간다.
            if (EnemyTeam.All(p => p.IsFainted)) return true;
            return await HandleForcedSwitch(true);
        }

        return stoppedAfterFaint;
    }

    private async Task<bool> HandleForcedSwitch(bool isHero)
    {
        if (isHero)
        {
            await CancelEffects();
            Menu = BattleMenu.ForcedSwitch;
            PromptText = "기술의 효과로 교체할 포켓몬을 선택하세요.";
            IsBusy = false;
            StateHasChanged();
            return true;
        }

        if (EnemyTeamIndex >= EnemyTeam.Count - 1)
        {
            await ShowMessage("상대는 교체할 포켓몬이 없다!");
            return false;
        }

        await PlayBattleEvent(BattleEvent.ActorStep(BattleEventPhase.Switch, Enemy, actorIsHero: false));
        Rules.PrepareSwitchOut(Enemy);
        EnemyTeamIndex++;
        EnemyMoveKeys = ResolveMoveKeys(Enemy);
        await ShowMessage($"{Enemy.Data.Name}이(가) 기술의 효과로 교체되어 나왔다!");
                 foreach (var message in Rules.ActivateSwitchIn(Enemy, Hero, GetIllusionTarget(Enemy, EnemyTeam), false))
            await ShowMessage(message, 1000);
        return false;
    }

    private async Task<bool> HandleFaint(Pokemon fainted, bool faintedIsHero)
    {
        await CancelEffects();
        if (faintedIsHero)
        {
            if (PlayerTeam.Any(p => !p.IsFainted))
            {
                Menu = BattleMenu.ForcedSwitch;
                PromptText = "쓰러진 포켓몬 대신 내보낼 포켓몬을 선택하세요.";
                IsBusy = false;
                StateHasChanged();
                return true;
            }
            await ShowMessage("내 포켓몬이 모두 쓰러졌다... 패배...");
            await State.LoseBattle(Turn, PlayerTeam);
            Nav.NavigateTo("/result");
            return true;
        }
        else
        {
            if (EnemyTeamIndex < EnemyTeam.Count - 1)
            {
                EnemyTeamIndex++;
                EnemyMoveKeys = ResolveMoveKeys(Enemy);
                await ShowMessage($"상대가 {Enemy.Data.Name}을(를) 내보냈다!");
                 foreach (var message in Rules.ActivateSwitchIn(Enemy, Hero, GetIllusionTarget(Enemy, EnemyTeam), false))
                {
                    await ShowMessage(message, 1000);
                }
                PromptText = "행동을 선택하세요.";
                IsBusy = false;
                Menu = BattleMenu.Main;
                StateHasChanged();
                return true;
            }
            await Rules.ApplyEndOfBattleEffectsAsync(PlayerTeam, PlayBattleEvent);
            await ShowMessage("상대 포켓몬을 모두 쓰러뜨렸다! 승리!");
            await State.WinRound(Turn, PlayerTeam);
            Nav.NavigateTo("/result");
            return true;
        }
    }

    private async Task UseMove(string? heroMoveKey)
    {
        if (IsBusy) return;
        IsBusy = true;
        ActionError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (Hero.RampageMoveKey != null)
            {
                heroMoveKey = Hero.RampageMoveKey;
            }

            if (heroMoveKey == null && HeroHasUsableMove)
            {
                await ShowMessage("사용할 수 있는 기술이 남아 있습니다.", 800);
                IsBusy = false;
                return;
            }

            if (heroMoveKey != null && !Hero.CanUseMove(heroMoveKey))
            {
                PendingMoveKey = null;
                Menu = BattleMenu.Attack;
                await ShowMessage("이 기술은 PP가 없거나 구애 도구로 잠겨 있어 사용할 수 없습니다.", 800);
                StateHasChanged();
                IsBusy = false;
                return;
            }

            if (heroMoveKey != null)
            {
                await State.RecordMoveSelectionAsync(heroMoveKey);
            }

            BeginActionLog();
            PendingMoveKey = null;
            await BeginEffects();
            Menu = BattleMenu.Main;
            Turn++;

            var turnPlan = Rules.PlanTurn(Hero, heroMoveKey, Enemy, EnemyMoveKeys);

            if (turnPlan.HeroFirst)
            {
                if (await RunTurn(Hero, Enemy, heroMoveKey, true, attackerMovedFirst: true)) return;
                if (!Enemy.IsFainted && !Hero.IsFainted)
                {
                    if (await RunTurn(Enemy, Hero, turnPlan.EnemyMoveKey, false, attackerMovedFirst: false)) return;
                }
            }
            else
            {
                if (await RunTurn(Enemy, Hero, turnPlan.EnemyMoveKey, false, attackerMovedFirst: true)) return;
                if (!Hero.IsFainted && !Enemy.IsFainted)
                {
                    if (await RunTurn(Hero, Enemy, heroMoveKey, true, attackerMovedFirst: false)) return;
                }
            }

            await Rules.ApplyEndOfTurnEffectsAsync(new[] { Hero, Enemy }, PlayBattleEvent);

            if (Hero.IsFainted) { if (await HandleFaint(Hero, true)) return; }
            if (Enemy.IsFainted) { if (await HandleFaint(Enemy, false)) return; }

            await FinishPlayerAction();
        }
        catch (Exception exception)
        {
            await RecoverFromActionError(exception);
        }
    }

    private async Task SwitchTo(int newIndex)
    {
        if (IsBusy) return;
        IsBusy = true;
        ActionError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            BeginActionLog();
            await BeginEffects();
            Menu = BattleMenu.Main;
            Turn++;

            var outgoing = Hero;
            await PlayBattleEvent(BattleEvent.ActorStep(BattleEventPhase.Switch, outgoing, actorIsHero: true));
            int hpBeforeSwitch = outgoing.CurrentHp;
            var statusBeforeSwitch = outgoing.Status;
            Rules.PrepareSwitchOut(outgoing);
            if (outgoing.CurrentHp > hpBeforeSwitch)
            {
                await ShowMessage($"{outgoing.Data.Name}은(는) {outgoing.SelectedAbility}으로 HP를 회복했다!", 900);
            }
            if (statusBeforeSwitch != StatusCondition.None && outgoing.Status == StatusCondition.None)
            {
                await ShowMessage($"{outgoing.Data.Name}은(는) 자연회복으로 상태 이상을 회복했다!", 900);
            }
            PlayerTeamIndex = newIndex;
            HeroMoveKeys = ResolveMoveKeys(Hero);
            await ShowMessage($"{Hero.Data.Name}을(를) 내보냈다!");
            foreach (var message in Rules.ActivateSwitchIn(Hero, Enemy, GetIllusionTarget(Hero, PlayerTeam)))
            {
                await ShowMessage(message, 1000);
            }

            string? enemyMoveKey = Rules.PickEnemyMove(Enemy, EnemyMoveKeys, Hero);
            if (await RunTurn(Enemy, Hero, enemyMoveKey, false, attackerMovedFirst: true)) return;

            await Rules.ApplyEndOfTurnEffectsAsync(new[] { Hero, Enemy }, PlayBattleEvent);
            if (Hero.IsFainted) { if (await HandleFaint(Hero, true)) return; }

            await FinishPlayerAction();
        }
        catch (Exception exception)
        {
            await RecoverFromActionError(exception);
        }
    }

    private async Task ForcedSwitchTo(int idx)
    {
        if (IsBusy || idx < 0 || idx >= PlayerTeam.Count || PlayerTeam[idx].IsFainted)
            return;

        IsBusy = true;
        ActionError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            BeginActionLog();
            await BeginEffects();
            var outgoing = Hero;
            await PlayBattleEvent(BattleEvent.ActorStep(BattleEventPhase.Switch, outgoing, actorIsHero: true));
            int hpBeforeSwitch = outgoing.CurrentHp;
            var statusBeforeSwitch = outgoing.Status;
            Rules.PrepareSwitchOut(outgoing);
            if (outgoing.CurrentHp > hpBeforeSwitch)
                await ShowMessage($"{outgoing.Data.Name}은(는) {outgoing.SelectedAbility}으로 HP를 회복했다!", 900);
            if (statusBeforeSwitch != StatusCondition.None && outgoing.Status == StatusCondition.None)
                await ShowMessage($"{outgoing.Data.Name}은(는) 자연회복으로 상태 이상을 회복했다!", 900);

            PlayerTeamIndex = idx;
            HeroMoveKeys = ResolveMoveKeys(Hero);
            Menu = BattleMenu.Main;
            await ShowMessage($"{Hero.Data.Name}을(를) 내보냈다!");
            foreach (var message in Rules.ActivateSwitchIn(Hero, Enemy, GetIllusionTarget(Hero, PlayerTeam)))
            {
                await ShowMessage(message, 1000);
            }

            // 기절 후 강제 교체는 끝난 턴의 연장이므로 턴 종료 효과를 반복하지 않는다.
            if (Hero.IsFainted) { if (await HandleFaint(Hero, true)) return; }
            if (Enemy.IsFainted) { if (await HandleFaint(Enemy, false)) return; }

            await FinishPlayerAction();
        }
        catch (Exception exception)
        {
            await RecoverFromActionError(exception);
        }
    }

    private async Task RecoverFromActionError(Exception exception)
    {
        Logger.LogError(exception, "Battle action failed; returning the circuit to a retryable state.");
        try
        {
            await CancelEffects();
        }
        catch
        {
            // 오류 복구 중 효과 정리까지 실패해도 배틀 상태 복구는 계속한다.
        }

        IsBusy = false;
        PendingMoveKey = null;
        Menu = BattleMenu.Main;
        PromptText = null;
        ActionError = "배틀 처리 중 문제가 발생했습니다. 현재 상태를 유지했으니 다시 시도해주세요.";
        LogHistory.Add("오류가 발생했습니다. 다시 시도해주세요.");
        if (LogHistory.Count > MaxBattleLogLines) LogHistory.RemoveAt(0);
        pendingLogScroll = true;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // 렌더링 중 발생한 예외는 여기서 다시 전파하지 않는다.
        }
    }

    private void BeginActionLog()
    {
        // 행동 로그는 누적하고 새 턴 시작 지점만 표시한다.
        LogHistory.Add($"── {Turn + 1}턴 시작 ──");
        if (LogHistory.Count > MaxBattleLogLines) LogHistory.RemoveAt(0);
        pendingLogScroll = true;
        PromptText = null;
    }

    private async Task FinishPlayerAction()
    {
        await EndEffects();
        IsBusy = false;
        ActionError = null;

        if (!Hero.IsFainted && Hero.RampageMoveKey != null)
        {
            await UseMove(null);
            return;
        }

        PromptText = "행동을 선택하세요.";
        StateHasChanged();
    }

    private Task RetryBattleAction()
    {
        ActionError = null;
        PromptText = "행동을 선택하세요.";
        return InvokeAsync(StateHasChanged);
    }
}

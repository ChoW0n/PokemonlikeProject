    private async Task CycleSpeed()
    {
        SpeedMultiplier = SpeedMultiplier switch
        {
            1.0 => 1.6,
            1.6 => 2.4,
            2.4 => 3.5,
            3.5 => 5.0,
            _ => 1.0
        };

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            SpeedStorageKey,
            SpeedMultiplier.ToString(CultureInfo.InvariantCulture));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingLogRender is { } renderedLog)
        {
            pendingLogRender = null;
            renderedLog.TrySetResult(true);
        }

        if (pendingLogScroll)
        {
            pendingLogScroll = false;
            await JS.InvokeVoidAsync("battleEffects.scrollLogToBottom");
        }

        if (!firstRender) return;

        string? savedSpeed = await JS.InvokeAsync<string?>("localStorage.getItem", SpeedStorageKey);
        if (double.TryParse(
                savedSpeed,
                NumberStyles.Float,
                CultureInfo.InvariantCulture,
                out double savedMultiplier)
            && SpeedOptions.Contains(savedMultiplier))
        {
            SpeedMultiplier = savedMultiplier;
            await InvokeAsync(StateHasChanged);
        }
    }


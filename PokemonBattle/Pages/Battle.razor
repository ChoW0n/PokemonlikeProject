@page "/battle"
@using PokemonBattle.Models
@using PokemonBattle.Services
@using PokemonBattle.Components
@using Microsoft.JSInterop
@inject GameState State
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BattleEngine Rules

<PageTitle>포켓몬 배틀</PageTitle>

<main class="battle-page">
    <header class="battle-header">
        <div>
            <p class="eyebrow">BATTLE LAB / SERVER SESSION</p>
            <h1>포켓몬 배틀</h1>
            <p class="intro">현재 날씨: @BattleWeather.Current</p>
        </div>
        <button type="button" class="speed-toggle" aria-label="배틀 메시지 재생 속도 변경" @onclick="CycleSpeed">재생속도 @SpeedLabel</button>
    </header>

    <section class="arena-stage" aria-label="배틀 상태" aria-describedby="battle-state-summary">
        <p id="battle-state-summary" class="visually-hidden">상대와 내 포켓몬의 이름, 레벨, 타입, 현재 HP와 상태 이상을 표시합니다.</p>
        <div class="stage-slot slot-top">
            <div class="hud-plate" aria-label="@($"{Enemy.Data.Name} 상태: HP {Enemy.CurrentHp}/{Enemy.MaxHp}{(StatusText(Enemy) == "" ? "" : $", {StatusText(Enemy)}")}")">
                <span class="hud-name">@Enemy.Data.Name</span>
                <span class="hud-level">Lv.@Enemy.Level</span>
                <div class="hud-types">
                    <img src="@TypeIcons.GetUrl(Enemy.Data.Type1)" class="type-icon-img" alt="@Enemy.Data.Type1" />
                    @if (Enemy.Data.Type2 != null)
                    {
                        <img src="@TypeIcons.GetUrl(Enemy.Data.Type2.Value)" class="type-icon-img" alt="@Enemy.Data.Type2" />
                    }
                </div>
                <div class="hud-hp-row">
                    <span class="hp-label">HP</span>
                    <div class="health-track" role="progressbar" aria-label="@($"{Enemy.Data.Name} HP")" aria-valuemin="0" aria-valuemax="@Enemy.MaxHp" aria-valuenow="@Enemy.CurrentHp" aria-valuetext="@($"{Enemy.CurrentHp} / {Enemy.MaxHp}")"><span class="health-fill @HpClass(EnemyHpPercent)" style="width:@EnemyHpPercent%"></span></div>
                </div>
                <span class="hud-hp-num @(EnemyHpPercent <= 20 ? "hp-critical" : "")">@Enemy.CurrentHp/@Enemy.MaxHp</span>
                @if (StatusText(Enemy) != "")
                {
                    <span class="hud-status">@StatusText(Enemy)</span>
                }
            </div>
            <div class="platform-shadow"></div>
            <img id="sprite-enemy" src="@Enemy.Data.EffectiveImageUrl" alt="@Enemy.Data.Name" class="fighter-sprite" />
        </div>

        <div class="stage-slot slot-bottom">
            <img id="sprite-hero" src="@Hero.Data.EffectiveBackImageUrl" alt="@Hero.Data.Name" class="fighter-sprite" />
            <div class="platform-shadow"></div>
            <div class="hud-plate" aria-label="@($"{Hero.Data.Name} 상태: HP {Hero.CurrentHp}/{Hero.MaxHp}{(StatusText(Hero) == "" ? "" : $", {StatusText(Hero)}")}")">
                <span class="hud-name">@Hero.Data.Name</span>
                <span class="hud-level">Lv.@Hero.Level</span>
                <div class="hud-types">
                    <img src="@TypeIcons.GetUrl(Hero.Data.Type1)" class="type-icon-img" alt="@Hero.Data.Type1" />
                    @if (Hero.Data.Type2 != null)
                    {
                        <img src="@TypeIcons.GetUrl(Hero.Data.Type2.Value)" class="type-icon-img" alt="@Hero.Data.Type2" />
                    }
                </div>
                <div class="hud-hp-row">
                    <span class="hp-label">HP</span>
                    <div class="health-track" role="progressbar" aria-label="@($"{Hero.Data.Name} HP")" aria-valuemin="0" aria-valuemax="@Hero.MaxHp" aria-valuenow="@Hero.CurrentHp" aria-valuetext="@($"{Hero.CurrentHp} / {Hero.MaxHp}")"><span class="health-fill @HpClass(HeroHpPercent)" style="width:@HeroHpPercent%"></span></div>
                </div>
                <span class="hud-hp-num @(HeroHpPercent <= 20 ? "hp-critical" : "")">@Hero.CurrentHp/@Hero.MaxHp</span>
                @if (StatusText(Hero) != "")
                {
                    <span class="hud-status">@StatusText(Hero)</span>
                }
            </div>
        </div>
    </section>

    <div class="team-order" aria-label="내 팀 순서" role="list">
        @for (int i = 0; i < PlayerTeam.Count; i++)
        {
            int idx = i;
            var member = PlayerTeam[idx];
            <div class="order-slot @(idx == PlayerTeamIndex ? "is-active" : "") @(member.IsFainted ? "is-fainted" : "")" role="listitem" aria-label="@($"{idx + 1}번 {member.Data.Name}{(idx == PlayerTeamIndex ? ", 현재 출전 중" : "")}{(member.IsFainted ? ", 기절" : "")}")">
                <img src="@member.Data.EffectiveImageUrl" alt="@member.Data.Name" />
            </div>
        }
    </div>

    <section class="command-panel" aria-label="배틀 커맨드" aria-labelledby="command-heading">
        <div class="panel-heading">
            <p class="eyebrow">TURN @Turn</p>
            <h2 id="command-heading">@MenuTitle</h2>
        </div>

        @if (Menu == BattleMenu.Main)
        {
            <div class="action-grid">
                <button type="button" class="action-tile action-attack" disabled="@IsBusy" @onclick="OpenAttackMenu">
                    <span class="action-icon">⚔</span>
                    <span>공격</span>
                </button>
                <button type="button" class="action-tile action-switch" disabled="@IsBusy" @onclick="() => Menu = BattleMenu.Switch">
                    <span class="action-icon">🔄</span>
                    <span>교체</span>
                </button>
            </div>
        }
        else if (Menu == BattleMenu.Attack)
        {
            <div class="move-name-grid">
                @foreach (var moveKey in HeroMoveKeys)
                {
                    var move = MoveDatabase.All[moveKey];
                    int ppLoop = Hero.CurrentPP[moveKey];
                    <button type="button"
                            class="move-name-button @(PendingMoveKey == moveKey ? "is-pending" : "")"
                            disabled="@(IsBusy || !Hero.CanUseMove(moveKey))"
                             aria-pressed="@(PendingMoveKey == moveKey ? "true" : "false")"
                             aria-label="@($"{move.Name}, PP {ppLoop}/{move.MaxPP}{(Hero.CanUseMove(moveKey) ? "" : ", 사용할 수 없음")}")"
                             @onclick="() => TapMove(moveKey)">
                        <span class="type-dot" style="background:@TypeColors.GetHex(move.Type)"></span>
                        <span class="move-name-text">@move.Name @(move.Priority > 0 ? "⚡" : "") @(Hero.ChoiceLockedMove != null && Hero.ChoiceLockedMove != moveKey ? "🔒" : "")</span>
                        <span class="move-pp-num">@ppLoop/@move.MaxPP</span>
                    </button>
                }
                @if (!HeroHasUsableMove)
                {
                    <button type="button"
                            class="move-name-button"
                            disabled="@IsBusy"
                            aria-label="몸부림, 사용 가능한 기술 없음"
                            @onclick="() => UseMove(null)">
                        <span class="type-dot" style="background:@TypeColors.GetHex(PokemonType.Normal)"></span>
                        <span class="move-name-text">몸부림</span>
                        <span class="move-pp-num">PP 없음</span>
                    </button>
                }
            </div>

            @if (PendingMoveKey != null)
            {
                var pmove = MoveDatabase.All[PendingMoveKey];
                    double pmult = pmove.IsStatus ? 1.0 : Rules.PreviewMultiplier(pmove, Enemy, Hero);
                int pp = Hero.CurrentPP[PendingMoveKey];
                <div id="selected-move-details" class="move-detail-panel" role="region" aria-label="@($"{pmove.Name} 상세 정보")">
                    @if (!pmove.IsStatus)
                    {
                        <GaugeBar Label="위력" Percent="@StatBarHelper.PowerPercent(pmove.Power)" ColorClass="@StatBarHelper.PowerColor(pmove.Power)" DisplayText="@pmove.Power.ToString()" />
                    }
                    <GaugeBar Label="명중" Percent="@(pmove.AlwaysHits ? 100 : StatBarHelper.AccuracyPercent(pmove.Accuracy))" ColorClass="@(pmove.AlwaysHits ? "gauge-vhigh" : StatBarHelper.AccuracyColor(pmove.Accuracy))" DisplayText="@(pmove.AlwaysHits ? "필중" : $"{pmove.Accuracy}%")" />
                    <GaugeBar Label="PP" Percent="@StatBarHelper.PpPercent(pp, pmove.MaxPP)" ColorClass="@StatBarHelper.PpColor(pp, pmove.MaxPP)" DisplayText="@($"{pp}/{pmove.MaxPP}")" />
                    @if (pmove.MaxHits > 1)
                    {
                        <p class="move-star-line">🔁 @pmove.MinHits~@(pmove.MaxHits)회 연속 타격</p>
                    }
                    @if (pmult >= 2.0)
                    {
                        <p class="move-star-line">⭐ 효과가 굉장하다!</p>
                    }
                    @{ var summary = MoveEffectSummary(pmove); }
                    @if (summary != "")
                    {
                        <p class="move-detail-effect">@summary</p>
                    }
                    <p class="move-detail-desc">@(string.IsNullOrWhiteSpace(pmove.Description) ? "설명 없음" : pmove.Description)</p>
                    <div class="move-detail-actions">
                         <button type="button" class="move-cancel" aria-label="기술 선택 취소" @onclick="() => PendingMoveKey = null">취소</button>
                         <button type="button" class="move-confirm" aria-label="@($"{pmove.Name} 시전 확정")" disabled="@IsBusy" @onclick="() => UseMove(PendingMoveKey!)">이 기술 시전</button>
                    </div>
                </div>
            }

            <button type="button" class="back-button" aria-label="행동 선택으로 돌아가기" disabled="@IsBusy" @onclick="() => { Menu = BattleMenu.Main; PendingMoveKey = null; }">← 뒤로</button>
        }
        else if (Menu == BattleMenu.Switch)
        {
            @if (!Rules.CanSwitch(Hero, Enemy))
            {
                <p class="move-detail-effect">@($"{Enemy.Data.Name}의 {Enemy.SelectedAbility} 때문에 교체할 수 없습니다.")</p>
            }
            <div class="move-grid">
                @for (int i = 0; i < PlayerTeam.Count; i++)
                {
                    int idx = i;
                    var member = PlayerTeam[idx];
                    bool canSwitch = !member.IsFainted && idx != PlayerTeamIndex
                        && Rules.CanSwitch(Hero, Enemy);
                    <button type="button"
                            class="move-button"
                            disabled="@(IsBusy || !canSwitch)"
                            aria-label="@($"{member.Data.Name}, 레벨 {member.Level}, HP {member.CurrentHp}/{member.MaxHp}{(member.IsFainted ? ", 기절" : "")}{(!canSwitch ? ", 교체할 수 없음" : "")}")"
                            @onclick="() => SwitchTo(idx)">
                        <div class="move-main">
                            <span class="move-name">@member.Data.Name</span>
                            <span class="move-meta">Lv.@member.Level · HP @member.CurrentHp/@member.MaxHp @(member.IsFainted ? "· 기절" : "")</span>
                        </div>
                    </button>
                }
                <button type="button" class="back-button" aria-label="행동 선택으로 돌아가기" disabled="@IsBusy" @onclick="() => Menu = BattleMenu.Main">← 뒤로</button>
            </div>
        }
        else if (Menu == BattleMenu.ForcedSwitch)
        {
            <div class="move-grid">
                @for (int i = 0; i < PlayerTeam.Count; i++)
                {
                    int idx = i;
                    var member = PlayerTeam[idx];
                    bool canPick = !member.IsFainted;
                    <button type="button"
                            class="move-button"
                            disabled="@(!canPick)"
                            aria-label="@($"{member.Data.Name}, 레벨 {member.Level}, HP {member.CurrentHp}/{member.MaxHp}{(member.IsFainted ? ", 기절" : "")}")"
                            @onclick="() => ForcedSwitchTo(idx)">
                        <div class="move-main">
                            <span class="move-name">@member.Data.Name</span>
                            <span class="move-meta">Lv.@member.Level · HP @member.CurrentHp/@member.MaxHp @(member.IsFainted ? "· 기절" : "")</span>
                        </div>
                    </button>
                }
            </div>
        }

        <div class="battle-log-panel" role="log" aria-live="polite" aria-atomic="false" aria-label="전투 로그">
            @foreach (var entry in LogHistory)
            {
                <p class="log-line @(entry == LogHistory[^1] ? "is-latest" : "is-fading")">
                    <span class="log-marker"></span><span class="log-text" data-full="@entry">@entry</span>
                </p>
            }
        </div>
    </section>
</main>

@code {
    private enum BattleMenu { Main, Attack, Switch, ForcedSwitch }

    private List<Pokemon> PlayerTeam = null!;
    private List<Pokemon> EnemyTeam = null!;
    private int PlayerTeamIndex;
    private int EnemyTeamIndex;
    private BattleMenu Menu = BattleMenu.Main;
    private string? PendingMoveKey;

    private Pokemon Hero => PlayerTeam[PlayerTeamIndex];
    private Pokemon Enemy => EnemyTeam[EnemyTeamIndex];

    private List<string> HeroMoveKeys = null!;
    private List<string> EnemyMoveKeys = null!;
    private bool HeroHasUsableMove => HeroMoveKeys.Any(Hero.CanUseMove);

    private int Turn;
    private bool IsBusy;

    private List<string> LogHistory = new() { "행동을 선택하세요." };

    private double SpeedMultiplier = 1.0;
    private string SpeedLabel => SpeedMultiplier == 1.0 ? "x1" : SpeedMultiplier == 1.6 ? "x1.6" : "x2.4";

    private void CycleSpeed()
    {
        SpeedMultiplier = SpeedMultiplier == 1.0 ? 1.6 : SpeedMultiplier == 1.6 ? 2.4 : 1.0;
    }

    private Random rng = new Random();

    private int HeroHpPercent => (int)(100.0 * Hero.CurrentHp / Hero.MaxHp);
    private int EnemyHpPercent => (int)(100.0 * Enemy.CurrentHp / Enemy.MaxHp);

    private string MenuTitle => Menu switch
    {
        BattleMenu.Attack => "기술 선택",
        BattleMenu.Switch => "교체할 포켓몬 선택",
        BattleMenu.ForcedSwitch => "내보낼 포켓몬을 선택하세요",
        _ => "행동 선택"
    };

    private string HpClass(int percent) => percent <= 20 ? "hp-low" : percent <= 50 ? "hp-mid" : "hp-high";

    private string StatusText(Pokemon p)
    {
        var parts = new List<string>();
        if (p.Status != StatusCondition.None) parts.Add(StatusKor(p.Status));
        if (p.IsConfused) parts.Add("혼란");
        return string.Join(" · ", parts);
    }

    private static string StatusKor(StatusCondition s) => s switch
    {
        StatusCondition.Burn => "화상",
        StatusCondition.Poison => "독",
        StatusCondition.Paralysis => "마비",
        StatusCondition.Sleep => "잠듦",
        StatusCondition.Freeze => "얼음",
        _ => ""
    };

    private static string AilmentKor(string a) => a switch
    {
        "paralysis" => "마비", "poison" => "독", "burn" => "화상",
        "sleep" => "잠듦", "freeze" => "얼음", "confusion" => "혼란",
        _ => a
    };

    private static string StatKor(string s) => s switch
    {
        "attack" => "공격", "defense" => "방어", "special-attack" => "특공",
        "special-defense" => "특방", "speed" => "속도", _ => s
    };

    private static string MoveEffectSummary(Move move)
    {
        var parts = new List<string>();
        if (move.AilmentName != "none") parts.Add($"{AilmentKor(move.AilmentName)} {move.AilmentChance}%");
        if (move.FlinchChance > 0) parts.Add($"움찔 {move.FlinchChance}%");
        foreach (var sc in move.StatChanges)
        {
            string dir = sc.Change > 0 ? "+" : "";
            parts.Add($"{StatKor(sc.Stat)} {dir}{sc.Change}({(sc.TargetsSelf ? "자신" : "상대")}) {move.StatChangeChance}%");
        }
        return string.Join(", ", parts);
    }

    protected override void OnInitialized()
    {
        if (State.PlayerLoadouts.Count > 0)
        {
            PlayerTeam = State.PlayerLoadouts.Select(l =>
                new Pokemon(PokemonDatabase.All[l.PokemonId], l.ChosenMoveNames, l.ChosenAbility, l.ChosenItem, l.Level)
            ).ToList();
        }
        else if (State.PlayerTeamIds.Count > 0)
        {
            PlayerTeam = State.PlayerTeamIds.Select(id => new Pokemon(PokemonDatabase.All[id])).ToList();
        }
        else
        {
            PlayerTeam = new List<Pokemon> { new Pokemon(PokemonDatabase.All[State.SelectedPokemonId]) };
        }

        if (State.EnemyLoadouts.Count > 0)
        {
            EnemyTeam = State.EnemyLoadouts.Select(l =>
                new Pokemon(PokemonDatabase.All[l.PokemonId], l.ChosenMoveNames, l.ChosenAbility, l.ChosenItem, l.Level)
            ).ToList();
        }
        else
        {
            int enemyLevel = 1 + State.CurrentScore;
            EnemyTeam = State.EnemyTeamIds.Count > 0
                ? State.EnemyTeamIds.Select(id => BuildRandomEnemy(id, enemyLevel)).ToList()
                : new List<Pokemon> { BuildRandomEnemy(State.EnemyPokemonId, enemyLevel) };
        }

        HeroMoveKeys = ResolveMoveKeys(Hero);
        EnemyMoveKeys = ResolveMoveKeys(Enemy);

        var initialAbilityMessages = Rules.InitializeWeather(Hero, Enemy);
        if (initialAbilityMessages.Count > 0)
        {
            LogHistory = initialAbilityMessages
                .Append("행동을 선택하세요.")
                .TakeLast(4)
                .ToList();
        }
    }

    private Pokemon BuildRandomEnemy(int id, int level)
    {
        var data = PokemonDatabase.All[id];
        var pool = EnemyTeamProvider.PickProMoveset(data);
        string ability = data.AbilityNames.Length > 0 ? data.AbilityNames[rng.Next(data.AbilityNames.Length)] : "";
        var items = ItemDatabase.GetAvailableItems(data.Name);
        string item = items[rng.Next(items.Count)].Name;
        return new Pokemon(data, pool, ability, item, level);
    }

    private static List<string> ResolveMoveKeys(Pokemon pokemon) => pokemon.CurrentPP.Keys.ToList();

    private void OpenAttackMenu()
    {
        PendingMoveKey = null;
        Menu = BattleMenu.Attack;
    }

    private void TapMove(string key)
    {
        if (PendingMoveKey == key)
        {
            UseMove(key);
        }
        else
        {
            PendingMoveKey = key;
        }
    }

    //메시지 추가 + 타이핑 재생 + 읽을 시간 대기 (전부 배속 반영)
    private async Task ShowMessage(string message, int baseDelayMs = 1400)
    {
        LogHistory.Add(message);
        if (LogHistory.Count > 4) LogHistory.RemoveAt(0);

        StateHasChanged();

        int typingMs = Math.Max(300, message.Length * 35);
        double typingActual = typingMs / SpeedMultiplier;
        await JS.InvokeVoidAsync("battleEffects.typeLastLine", typingActual);

        double readDelay = Math.Max(250, (baseDelayMs - typingMs) / SpeedMultiplier);
        await Task.Delay((int)readDelay);
    }

    private async Task PlayEffect(string kind, bool attackerIsHero, PokemonType type)
    {
        await JS.InvokeVoidAsync("battleEffects.play", kind, attackerIsHero ? "hero" : "enemy", TypeColors.GetHex(type));
    }

    private async Task PlayBattleEvent(BattleEvent battleEvent)
    {
        if (battleEvent.EffectKind != null && battleEvent.EffectType != null)
        {
            string attackerName = battleEvent.AttackerIsHero ? Hero.Data.Name : Enemy.Data.Name;
            await JS.InvokeVoidAsync(
                "battleEffects.play",
                battleEvent.EffectKind,
                battleEvent.AttackerIsHero ? "hero" : "enemy",
                TypeColors.GetHex(battleEvent.EffectType.Value),
                battleEvent.MoveName ?? "기술",
                attackerName,
                TypeKor(battleEvent.EffectType.Value));
        }
        else if (battleEvent.Message != null)
        {
            await ShowMessage(battleEvent.Message, battleEvent.BaseDelayMs);
        }
    }

    private static string TypeKor(PokemonType type) => type switch
    {
        PokemonType.Normal => "노말",
        PokemonType.Fire => "불꽃",
        PokemonType.Water => "물",
        PokemonType.Electric => "전기",
        PokemonType.Grass => "풀",
        PokemonType.Ice => "얼음",
        PokemonType.Fighting => "격투",
        PokemonType.Poison => "독",
        PokemonType.Ground => "땅",
        PokemonType.Flying => "비행",
        PokemonType.Psychic => "에스퍼",
        PokemonType.Bug => "벌레",
        PokemonType.Rock => "바위",
        PokemonType.Ghost => "고스트",
        PokemonType.Dragon => "드래곤",
        PokemonType.Dark => "악",
        PokemonType.Steel => "강철",
        PokemonType.Fairy => "페어리",
        _ => type.ToString()
    };

    private async Task<bool> RunTurn(Pokemon attacker, Pokemon defender, string? moveKey, bool attackerIsHero)
    {
        var result = await Rules.TakeTurnAsync(attacker, defender, moveKey, attackerIsHero, PlayBattleEvent);

        if (result.FaintedPokemon == null) return false;

        bool faintedIsAttacker = ReferenceEquals(result.FaintedPokemon, attacker);
        if (!faintedIsAttacker)
        {
            await ShowMessage($"{result.FaintedPokemon.Data.Name}은(는) 쓰러졌다!");
        }

        return await HandleFaint(
            result.FaintedPokemon,
            faintedIsAttacker ? attackerIsHero : !attackerIsHero);
    }

    private async Task<bool> HandleFaint(Pokemon fainted, bool faintedIsHero)
    {
        if (faintedIsHero)
        {
            if (PlayerTeam.Any(p => !p.IsFainted))
            {
                Menu = BattleMenu.ForcedSwitch;
                LogHistory.Add("쓰러진 포켓몬 대신 내보낼 포켓몬을 선택하세요.");
                if (LogHistory.Count > 4) LogHistory.RemoveAt(0);
                IsBusy = false;
                StateHasChanged();
                return true;
            }
            await ShowMessage("내 포켓몬이 모두 쓰러졌다... 패배...");
            await State.LoseBattle();
            Nav.NavigateTo("/result");
            return true;
        }
        else
        {
            if (EnemyTeamIndex < EnemyTeam.Count - 1)
            {
                EnemyTeamIndex++;
                EnemyMoveKeys = ResolveMoveKeys(Enemy);
                await ShowMessage($"상대가 {Enemy.Data.Name}을(를) 내보냈다!");
                foreach (var message in Rules.ActivateSwitchIn(Enemy, Hero))
                {
                    await ShowMessage(message, 1000);
                }
                LogHistory.Add("행동을 선택하세요.");
                if (LogHistory.Count > 4) LogHistory.RemoveAt(0);
                IsBusy = false;
                Menu = BattleMenu.Main;
                StateHasChanged();
                return true;
            }
            await ShowMessage("상대 포켓몬을 모두 쓰러뜨렸다! 승리!");
            await State.WinRound();
            Nav.NavigateTo("/result");
            return true;
        }
    }

    private async void UseMove(string? heroMoveKey)
    {
        if (heroMoveKey == null && HeroHasUsableMove)
        {
            await ShowMessage("사용할 수 있는 기술이 남아 있습니다.", 800);
            return;
        }

        if (heroMoveKey != null && !Hero.CanUseMove(heroMoveKey))
        {
            PendingMoveKey = null;
            Menu = BattleMenu.Attack;
            await ShowMessage("이 기술은 PP가 없거나 구애 도구로 잠겨 있어 사용할 수 없습니다.", 800);
            StateHasChanged();
            return;
        }

        PendingMoveKey = null;
        IsBusy = true;
        Menu = BattleMenu.Main;
        Turn++;

        var turnPlan = Rules.PlanTurn(Hero, heroMoveKey, Enemy, EnemyMoveKeys);

        if (turnPlan.HeroFirst)
        {
            if (await RunTurn(Hero, Enemy, heroMoveKey, true)) return;
            if (!Enemy.IsFainted && !Hero.IsFainted)
            {
                if (await RunTurn(Enemy, Hero, turnPlan.EnemyMoveKey, false)) return;
            }
        }
        else
        {
            if (await RunTurn(Enemy, Hero, turnPlan.EnemyMoveKey, false)) return;
            if (!Hero.IsFainted && !Enemy.IsFainted)
            {
                if (await RunTurn(Hero, Enemy, heroMoveKey, true)) return;
            }
        }

        await Rules.ApplyEndOfTurnEffectsAsync(new[] { Hero, Enemy }, PlayBattleEvent);

        if (Hero.IsFainted) { if (await HandleFaint(Hero, true)) return; }
        if (Enemy.IsFainted) { if (await HandleFaint(Enemy, false)) return; }

        LogHistory.Add("행동을 선택하세요.");
        if (LogHistory.Count > 4) LogHistory.RemoveAt(0);
        IsBusy = false;
        StateHasChanged();
    }

    private async void SwitchTo(int newIndex)
    {
        IsBusy = true;
        Menu = BattleMenu.Main;
        Turn++;

        var outgoing = Hero;
        int hpBeforeSwitch = outgoing.CurrentHp;
        var statusBeforeSwitch = outgoing.Status;
        Rules.PrepareSwitchOut(outgoing);
        if (outgoing.CurrentHp > hpBeforeSwitch)
        {
            await ShowMessage($"{outgoing.Data.Name}은(는) {outgoing.SelectedAbility}으로 HP를 회복했다!", 900);
        }
        if (statusBeforeSwitch != StatusCondition.None && outgoing.Status == StatusCondition.None)
        {
            await ShowMessage($"{outgoing.Data.Name}은(는) 자연회복으로 상태 이상을 회복했다!", 900);
        }
        PlayerTeamIndex = newIndex;
        HeroMoveKeys = ResolveMoveKeys(Hero);
        await ShowMessage($"{Hero.Data.Name}을(를) 내보냈다!");
        foreach (var message in Rules.ActivateSwitchIn(Hero, Enemy))
        {
            await ShowMessage(message, 1000);
        }

        string? enemyMoveKey = Rules.PickEnemyMove(Enemy, EnemyMoveKeys, Hero);
        if (await RunTurn(Enemy, Hero, enemyMoveKey, false)) return;

        await Rules.ApplyEndOfTurnEffectsAsync(new[] { Hero, Enemy }, PlayBattleEvent);
        if (Hero.IsFainted) { if (await HandleFaint(Hero, true)) return; }

        LogHistory.Add("행동을 선택하세요.");
        if (LogHistory.Count > 4) LogHistory.RemoveAt(0);
        IsBusy = false;
        StateHasChanged();
    }

    private async void ForcedSwitchTo(int idx)
    {
        PlayerTeamIndex = idx;
        HeroMoveKeys = ResolveMoveKeys(Hero);
        Menu = BattleMenu.Main;
        await ShowMessage($"{Hero.Data.Name}을(를) 내보냈다!");
        foreach (var message in Rules.ActivateSwitchIn(Hero, Enemy))
        {
            await ShowMessage(message, 1000);
        }
        LogHistory.Add("행동을 선택하세요.");
        if (LogHistory.Count > 4) LogHistory.RemoveAt(0);
        StateHasChanged();
    }
}

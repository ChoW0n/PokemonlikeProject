@page "/starter"
@using PokemonBattle.Models
@using PokemonBattle.Services
@inject GameState State
@inject UnlockService Unlocks
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>스타터 선택</PageTitle>

<main class="dex-page starter-page">
    <div class="pokedex-shell">
        <div class="pokedex-top">
            <div class="pokedex-lens"></div>
            <div class="pokedex-lights">
                <span class="light red"></span>
                <span class="light yellow"></span>
                <span class="light green"></span>
            </div>
        </div>

        <div id="starter-top" class="pokedex-screen">
            <div class="starter-header">
                <div>
                    <h1>스타터 선택</h1>
                    <p class="intro">이번 런에 함께할 포켓몬 3마리를 선택하세요. 스타터 기술은 우선 앞 4개로 구성되며, 시작 후 포켓몬 변경 화면에서 직접 다시 고를 수 있습니다.</p>
                </div>
                <strong class="starter-count">@SelectedIds.Count / 3</strong>
            </div>

            <div class="starter-tools" role="search" aria-label="스타터 포켓몬 검색 및 필터">
                <div class="collection-search-field">
                    <label for="starter-search">포켓몬 찾기</label>
                    <input id="starter-search" class="dex-search" type="search"
                           placeholder="이름, 영문 이름, 도감 번호로 검색"
                           value="@SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="collection-filter-field">
                    <label for="starter-type-filter">타입 필터</label>
                    <select id="starter-type-filter" value="@SelectedType" @onchange="OnTypeChanged">
                        <option value="all">전체 타입</option>
                        @foreach (var type in PokemonTypes)
                        {
                            <option value="@type.Type">@type.Label</option>
                        }
                    </select>
                </div>
            </div>

            <p class="starter-results" role="status" aria-live="polite">
                @(FilteredPokemon.Count == 0
                    ? "조건에 맞는 포켓몬이 없습니다."
                    : $"{FilteredPokemon.Count} / {AvailablePokemon.Count}마리 표시 중")
            </p>

            <div class="dex-grid starter-grid" role="list" aria-label="스타터 선택 포켓몬 목록">
                @foreach (var entry in FilteredPokemon)
                {
                    bool isSelected = SelectedIds.Contains(entry.Key);
                    <button type="button"
                            class="dex-entry dex-entry-button @(isSelected ? "is-selected" : string.Empty)"
                            aria-label="@($"{entry.Value.Name}, 도감 번호 {entry.Key}{(isSelected ? ", 선택됨" : "")}")"
                            aria-pressed="@(isSelected ? "true" : "false")"
                            @onclick="() => ToggleSelection(entry.Key)">
                        <span class="dex-number">No.@entry.Key.ToString("D3")</span>
                        <img src="@entry.Value.EffectiveImageUrl" alt="@entry.Value.Name" class="dex-sprite" />
                        <span class="dex-name">@entry.Value.Name</span>
                        <span class="dex-type-icons">
                            <img src="@TypeIcons.GetUrl(entry.Value.Type1)" class="type-icon-img small" alt="@entry.Value.Type1" />
                            @if (entry.Value.Type2 != null)
                            {
                                <img src="@TypeIcons.GetUrl(entry.Value.Type2.Value)" class="type-icon-img small" alt="@entry.Value.Type2" />
                            }
                        </span>
                            <div class="starter-stat-gauges" aria-label="@($"{entry.Value.Name} 종족값")">
                                <GaugeBar Label="HP" Percent="@StatBarHelper.StatPercent(entry.Value.BaseHp)" ColorClass="@StatBarHelper.StatColor(entry.Value.BaseHp)" DisplayText="@entry.Value.BaseHp.ToString()" />
                                <GaugeBar Label="공격" Percent="@StatBarHelper.StatPercent(entry.Value.BaseAtk)" ColorClass="@StatBarHelper.StatColor(entry.Value.BaseAtk)" DisplayText="@entry.Value.BaseAtk.ToString()" />
                                <GaugeBar Label="방어" Percent="@StatBarHelper.StatPercent(entry.Value.BaseDef)" ColorClass="@StatBarHelper.StatColor(entry.Value.BaseDef)" DisplayText="@entry.Value.BaseDef.ToString()" />
                                <GaugeBar Label="특공" Percent="@StatBarHelper.StatPercent(entry.Value.BaseSpAtk)" ColorClass="@StatBarHelper.StatColor(entry.Value.BaseSpAtk)" DisplayText="@entry.Value.BaseSpAtk.ToString()" />
                                <GaugeBar Label="특방" Percent="@StatBarHelper.StatPercent(entry.Value.BaseSpDef)" ColorClass="@StatBarHelper.StatColor(entry.Value.BaseSpDef)" DisplayText="@entry.Value.BaseSpDef.ToString()" />
                                <GaugeBar Label="속도" Percent="@StatBarHelper.StatPercent(entry.Value.BaseSpd)" ColorClass="@StatBarHelper.StatColor(entry.Value.BaseSpd)" DisplayText="@entry.Value.BaseSpd.ToString()" />
                            </div>
                    </button>
                }
            </div>

            <p class="starter-hint" aria-live="polite">
                @(SelectedIds.Count == 3
                    ? "선택이 완료되었습니다."
                    : $"포켓몬을 {3 - SelectedIds.Count}마리 더 선택하세요.")
            </p>

            <div class="starter-actions">
                <button type="button" @onclick="GoHome">취소</button>
                <button type="button" disabled="@(SelectedIds.Count != 3 || IsSubmitting)" @onclick="ConfirmSelection">
                    @(IsSubmitting ? "저장 중..." : "이 3마리로 시작하기")
                </button>
            </div>
        </div>
    </div>
</main>

@code {
    private readonly List<int> SelectedIds = new();
    private List<KeyValuePair<int, PokemonData>> AvailablePokemon = new();
    private string SearchText = "";
    private string SelectedType = "all";
    private bool IsSubmitting;

    private static readonly IReadOnlyList<(PokemonType Type, string Label)> PokemonTypes =
        new[]
        {
            (PokemonType.Normal, "노말"), (PokemonType.Fire, "불꽃"),
            (PokemonType.Water, "물"), (PokemonType.Electric, "전기"),
            (PokemonType.Grass, "풀"), (PokemonType.Ice, "얼음"),
            (PokemonType.Fighting, "격투"), (PokemonType.Poison, "독"),
            (PokemonType.Ground, "땅"), (PokemonType.Flying, "비행"),
            (PokemonType.Psychic, "에스퍼"), (PokemonType.Bug, "벌레"),
            (PokemonType.Rock, "바위"), (PokemonType.Ghost, "고스트"),
            (PokemonType.Dragon, "드래곤"), (PokemonType.Dark, "악"),
            (PokemonType.Steel, "강철"), (PokemonType.Fairy, "페어리")
        };

    private List<KeyValuePair<int, PokemonData>> FilteredPokemon =>
        AvailablePokemon
            .Where(entry =>
            {
                string search = SearchText.Trim();
                bool isDexNumber = int.TryParse(search, out int dexNumber);
                bool matchesSearch = string.IsNullOrEmpty(search)
                    || (isDexNumber
                        ? entry.Key == dexNumber
                        : entry.Value.Name.Contains(search, StringComparison.CurrentCultureIgnoreCase)
                            || entry.Value.EnglishName.Contains(search, StringComparison.OrdinalIgnoreCase));
                bool matchesType = SelectedType == "all"
                    || entry.Value.Type1.ToString() == SelectedType
                    || entry.Value.Type2?.ToString() == SelectedType;
                return matchesSearch && matchesType;
            })
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var unlockedIds = await Unlocks.GetUnlockedIds();
        AvailablePokemon = unlockedIds
            .Where(PokemonDatabase.All.ContainsKey)
            .OrderBy(id => id)
            .Select(id => new KeyValuePair<int, PokemonData>(id, PokemonDatabase.All[id]))
            .ToList();
    }

    private void OnSearchChanged(ChangeEventArgs args) =>
        SearchText = args.Value?.ToString() ?? "";

    private void OnTypeChanged(ChangeEventArgs args) =>
        SelectedType = args.Value?.ToString() ?? "all";

    private void ToggleSelection(int pokemonId)
    {
        if (SelectedIds.Contains(pokemonId))
        {
            SelectedIds.Remove(pokemonId);
        }
        else if (SelectedIds.Count < 3)
        {
            SelectedIds.Add(pokemonId);
        }
    }

    private async Task ConfirmSelection()
    {
        if (IsSubmitting || SelectedIds.Count != 3) return;

        var loadouts = SelectedIds
            .Where(PokemonDatabase.All.ContainsKey)
            .Select(id =>
            {
                var data = PokemonDatabase.All[id];
                return new PokemonLoadout
                {
                    PokemonId = id,
                    ChosenMoveNames = data.MoveNames
                        .Where(MoveDatabase.All.ContainsKey)
                        .Take(4)
                        .ToList(),
                    ChosenAbility = data.AbilityNames.FirstOrDefault() ?? "",
                    ChosenItem = TeamLoadoutRules.NoItem,
                    Level = State.CurrentRunLevel
                };
            })
            .ToList();

        if (loadouts.Count != 3) return;

        IsSubmitting = true;
        try
        {
            await State.SetPlayerLoadouts(loadouts);
            State.GoTo(GameScreen.EnemyPreview);
            Nav.NavigateTo("/preview");
        }
        catch
        {
            IsSubmitting = false;
        }
    }

    private void GoHome() => Nav.NavigateTo("/");
}
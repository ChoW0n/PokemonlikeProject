@page "/login"
@using PokemonBattle.Services
@inject AuthService Auth
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>로그인</PageTitle>

    <main class="start-page auth-page">
    <h1>포켓몬 배틀 로그인</h1>
        <p class="form-message" role="status" aria-live="polite">@Message</p>

        <form class="auth-form" @onsubmit="DoLogin" @onsubmit:preventDefault>
            <label for="login-username">아이디</label>
            <input id="login-username" class="dex-search" placeholder="아이디" autocomplete="username" required @bind-value="Username" @bind-value:event="oninput" />
            <label for="login-password">비밀번호</label>
            <input id="login-password" class="dex-search" placeholder="비밀번호 (6자 이상)" type="password" minlength="6" autocomplete="current-password" required @bind-value="Password" @bind-value:event="oninput" />

            <button type="submit" disabled="@IsSubmitting">@(IsSubmitting ? "로그인 중..." : "로그인")</button>
        </form>
        <button type="button" @onclick="GoRegister">회원가입 하러 가기</button>
</main>

@code {
    private string Username = "";
    private string Password = "";
    private string Message = "";
    private bool IsSubmitting;

    private async Task DoLogin()
    {
        if (IsSubmitting) return;
        if (string.IsNullOrWhiteSpace(Username))
        {
            Message = "아이디를 입력해주세요.";
            return;
        }
        if (Password.Length < 6)
        {
            Message = "비밀번호는 6자 이상 입력해주세요.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var (success, message, isAdmin) = await Auth.Login(Username, Password);
            if (success)
            {
                CurrentUser.SignIn(Username, isAdmin);
                Nav.NavigateTo("/");
            }
            else
            {
                Message = message;
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoRegister()
    {
        Nav.NavigateTo("/register");
    }
}

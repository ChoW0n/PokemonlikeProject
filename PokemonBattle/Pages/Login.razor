@page "/login"
@using PokemonBattle.Services
@inject AuthService Auth
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>로그인</PageTitle>

<main class="start-page auth-page" aria-labelledby="login-title">
    <header class="page-header auth-header">
        <p class="eyebrow">ACCOUNT ACCESS</p>
        <h1 id="login-title">포켓몬 배틀 로그인</h1>
        <p class="intro">저장된 진행 상황을 불러오려면 계정에 로그인해주세요.</p>
    </header>

    <p class="form-message @(MessageIsError ? "is-error" : "is-success")"
       role="@(MessageIsError ? "alert" : "status")"
       aria-live="@(MessageIsError ? "assertive" : "polite")">@Message</p>

    <form class="auth-form" @onsubmit="DoLogin" @onsubmit:preventDefault>
        <div class="form-field">
            <label for="login-username">아이디</label>
            <input id="login-username" class="dex-search auth-input" placeholder="아이디" autocomplete="username" required @bind-value="Username" @bind-value:event="oninput" />
        </div>
        <div class="form-field">
            <label for="login-password">비밀번호</label>
            <input id="login-password" class="dex-search auth-input" placeholder="비밀번호" type="password" autocomplete="current-password" required @bind-value="Password" @bind-value:event="oninput" />
        </div>

        <button type="submit" class="auth-primary" disabled="@IsSubmitting">@(IsSubmitting ? "로그인 중..." : "로그인")</button>
    </form>
    <button type="button" class="auth-secondary" @onclick="GoRegister">회원가입 하러 가기</button>
</main>

@code {
    private string Username = "";
    private string Password = "";
    private string Message = "";
    private bool MessageIsError;
    private bool IsSubmitting;

    private async Task DoLogin()
    {
        if (IsSubmitting) return;
        if (string.IsNullOrWhiteSpace(Username))
        {
            Message = "아이디를 입력해주세요.";
            MessageIsError = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(Password))
        {
            Message = "비밀번호를 입력해주세요.";
            MessageIsError = true;
            return;
        }

        IsSubmitting = true;
        try
        {
            var (success, message, isAdmin) = await Auth.Login(Username, Password);
            if (success)
            {
                CurrentUser.SignIn(Username, isAdmin);
                Nav.NavigateTo("/");
            }
            else
            {
                Message = message;
                MessageIsError = true;
            }
        }
        catch
        {
            Message = "로그인 중 문제가 발생했습니다. 잠시 후 다시 시도해주세요.";
            MessageIsError = true;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoRegister()
    {
        Nav.NavigateTo("/register");
    }
}

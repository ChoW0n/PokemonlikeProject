@page "/login"
@using PokemonBattle.Services
@inject AuthService Auth
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>로그인</PageTitle>

    <main class="start-page auth-page">
    <h1>포켓몬 배틀 로그인</h1>
        <p class="form-message" role="status" aria-live="polite">@Message</p>

        <form class="auth-form" @onsubmit="DoLogin" @onsubmit:preventDefault>
            <label for="login-username">아이디</label>
            <input id="login-username" class="dex-search" placeholder="아이디" autocomplete="username" @bind-value="Username" @bind-value:event="oninput" />
            <label for="login-password">비밀번호</label>
            <input id="login-password" class="dex-search" placeholder="비밀번호" type="password" autocomplete="current-password" @bind-value="Password" @bind-value:event="oninput" />

            <button type="submit">로그인</button>
        </form>
        <button type="button" @onclick="GoRegister">회원가입 하러 가기</button>
</main>

@code {
    private string Username = "";
    private string Password = "";
    private string Message = "";

    private async Task DoLogin()
    {
        var (success, message, isAdmin) = await Auth.Login(Username, Password);
        if (success)
        {
            CurrentUser.SignIn(Username, isAdmin);
            Nav.NavigateTo("/");
        }
        else
        {
            Message = message;
        }
    }

    private void GoRegister()
    {
        Nav.NavigateTo("/register");
    }
}

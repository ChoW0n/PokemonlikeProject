@page "/"
@using PokemonBattle.Services
@using PokemonBattle.Models
@inject GameState State
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>포켓몬 배틀</PageTitle>

<main class="start-page start-screen" aria-labelledby="start-title">
    <header class="page-header start-header">
        <p class="eyebrow">POKÉMON BATTLE / HOME</p>
        <h1 id="start-title">포켓몬 배틀</h1>
        <p class="intro">@CurrentUser.Username 님, 다시 전장으로 돌아오셨습니다.</p>
    </header>

    <section class="run-summary" aria-labelledby="run-summary-title">
        <div class="section-heading">
            <p class="eyebrow">RUN STATUS</p>
            <h2 id="run-summary-title">진행 현황</h2>
        </div>
        <dl class="run-stats">
            <div class="run-stat">
                <dt>최고 기록</dt>
                <dd>@State.HighScore</dd>
            </div>
            <div class="run-stat">
                <dt>현재 점수</dt>
                <dd>@State.CurrentScore</dd>
            </div>
            <div class="run-stat">
                <dt>일반 전투 완료</dt>
                <dd>@State.CompletedBattles<span>회</span></dd>
            </div>
        </dl>
    </section>

    <LegendaryHistory />

    <nav class="start-actions" aria-label="게임 메뉴">
        @if (CurrentUser.IsAdmin)
        {
            <button type="button" class="admin-link" @onclick="OpenAdminConsole">관리자 콘솔 열기</button>
        }

        <button type="button" class="start-primary" @onclick="StartGame">시작하기</button>
        <button type="button" @onclick="OpenMailbox">
            보관함
            @if (State.UnreadMailboxCount > 0)
            {
                <span aria-label="@($"{State.UnreadMailboxCount}개 읽지 않은 메시지")"> (@State.UnreadMailboxCount)</span>
            }
        </button>
        <button type="button" class="secondary-action" @onclick="OpenLeaderboard">유저 랭킹</button>
        <button type="button" @onclick="OpenCollection">획득한 포켓몬 전체 보기</button>
        <button type="button" class="secondary-action" @onclick="OpenWiki">게임 위키</button>
        <button type="button" class="secondary-action" @onclick="SignOut">로그아웃</button>
    </nav>
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await State.LoadRunForCurrentUser(); //뒤로가기/새로고침 등으로 회선이 새로 열려도 여기서 진행 상황 복구
    }

    private void StartGame()
    {
        if (State.PlayerLoadouts.Count == 0)
        {
            State.GoTo(GameScreen.StarterSelect);
            Nav.NavigateTo("/starter");
            return;
        }

        State.GoTo(GameScreen.EnemyPreview);
        Nav.NavigateTo("/preview");
    }

    private void OpenAdminConsole() => Nav.NavigateTo("/admin");
    private void OpenMailbox() => Nav.NavigateTo("/mailbox");
    private void OpenLeaderboard() => Nav.NavigateTo("/leaderboard");
    private void OpenCollection() => Nav.NavigateTo("/collection");
    private void OpenWiki() => Nav.NavigateTo("/wiki");

    private void SignOut()
    {
        CurrentUser.SignOut();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
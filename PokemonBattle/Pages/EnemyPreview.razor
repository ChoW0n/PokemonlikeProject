@page "/preview"
@using PokemonBattle.Services
@using PokemonBattle.Models
@using PokemonBattle.Components
@inject GameState State
@inject UnlockService Unlocks
@inject NavigationManager Nav

<PageTitle>상대 라인업</PageTitle>

<main class="preview-page">
    <p class="eyebrow">OPPONENT SCOUT / NEXT STAGE</p>
    <div class="preview-title-row">
        <h1>상대 포켓몬 라인업</h1>
        @if (State.IsRivalBattle)
        {
            <span class="rival-badge" aria-label="라이벌전">라이벌전</span>
            @if (!string.IsNullOrWhiteSpace(State.RivalUsername))
            {
                <span class="rival-opponent" aria-label="@($"라이벌 상대 {State.RivalUsername}")">
                    상대 · @State.RivalUsername
                </span>
            }
        }
    </div>
    <p class="preview-lead">클릭하면 스탯과 기술을 확인할 수 있습니다. 배틀에 들어가기 전 상대의 전력을 확인하세요.</p>
    <div class="preview-round-bar" aria-label="@($"현재 라운드 {State.CurrentScore + 1}")">
        <span>다음 전투</span>
        <strong>ROUND @(State.CurrentScore + 1)</strong>
        @if (State.IsRivalBattle)
        {
            <span class="preview-round-note">
                라이벌전 · @(State.RivalUsername ?? "상대")의 팀을 꼼꼼히 확인하세요.
            </span>
        }
    </div>
    <p class="config-label">
        전설 출현 진행도: @State.LegendaryProgressPercent%
        @if (State.LegendaryEncounterConsumed)
        {
            <span>· 이번 라인업에서 전설 출현 완료, 다음 주기 시작</span>
        }
        else if (State.LegendaryUnlocked && ContainsLegendary)
        {
            <span>· 이번 라인업에 전설이 출현했습니다</span>
        }
        else if (State.LegendaryUnlocked)
        {
            <span>· 전설 출현 가능 (이번 라인업에는 없어 진행도를 유지합니다)</span>
        }
        else
        {
            <span>· 스테이지 클리어로 다음 주기 진행</span>
        }
    </p>
    @if (State.CurrentBattlefieldImprint != null)
    {
        <section class="info-panel" aria-label="이번 스테이지 전장 각인">
            <strong>전장 각인 · @State.CurrentBattlefieldImprint.Name</strong>
            <p class="info-desc">@State.CurrentBattlefieldImprint.Description</p>
            <p class="config-label">
                날씨: @State.CurrentBattlefieldImprint.Weather · 필드: @State.CurrentBattlefieldImprint.Field
            </p>
        </section>
    }

    @if (State.CanChooseRiskCovenant && State.CurrentRiskCovenant != null)
    {
        <section class="info-panel risk-covenant-card" aria-label="위험 서약 선택">
            <div class="risk-covenant-heading">
                <strong>위험 서약 · @State.CurrentRiskCovenant.Name</strong>
                <span>선택 필요</span>
            </div>
            <p class="info-desc">@State.CurrentRiskCovenant.Description</p>
            <p class="config-label">보상: @State.CurrentRiskCovenant.RewardDescription</p>
            <div class="risk-choice-actions">
                <button type="button" class="risk-accept" @onclick="() => ChooseRisk(true)">서약 수락</button>
                <button type="button" class="risk-decline" @onclick="() => ChooseRisk(false)">이번에는 거절</button>
            </div>
        </section>
    }
    else if (State.RunMeta.RiskCovenantDecisionMade)
    {
        <p class="config-label">
            @(State.RunMeta.RiskCovenantAccepted
                ? $"위험 서약 수락 · {State.CurrentRiskCovenant?.RewardDescription}"
                : "위험 서약을 거절했습니다.")
        </p>
    }

    @if (EnemyLoadouts.Count == 0)
    {
        <p>상대 팀 구성 중...</p>
    }
    else
    {
        <EnemyTeamGrid Loadouts="EnemyLoadouts" />

        <button type="button" class="preview-primary-action" @onclick="ConfirmTeamAndGo">
            이 상대 팀(@(EnemyLoadouts.Count)마리)과 배틀 준비하기
        </button>
    }
</main>

@code {
    private List<PokemonLoadout> EnemyLoadouts = new();
    private bool ContainsLegendary => EnemyLoadouts.Any(loadout => EnemyTeamProvider.IsLegendary(loadout.PokemonId));

    protected override async Task OnInitializedAsync()
    {
        await State.LoadRunForCurrentUser();
        await State.EnsureStageMetaAsync();
        var unlocked = await Unlocks.GetUnlockedIds();

        var rival = await State.GetPendingRivalLoadoutsAsync();
        if (rival != null)
        {
            EnemyLoadouts = ApplyRiskBonus(rival);
            await State.SetEnemyLoadouts(EnemyLoadouts);
            return;
        }

        State.MarkNormalBattle();
        // 초반 신규 유저는 1단계 후보로 시작한다.
        bool firstStageOnly = unlocked.Count < 12 && !State.LegendaryUnlocked;
        int poolSize = State.LegendaryUnlocked
            ? 721
            : Math.Clamp(20 + unlocked.Count * 8, 30, 721);
        int teamSize = EnemyTeamProvider.GetTeamSizeForRound(State.CurrentRunLevel);
        int enemyLevel = Math.Max(
            1,
            State.CurrentRunLevel + State.CurrentRunDifficultyAdjustment
            + (State.RunMeta.RiskCovenantAccepted
                ? State.CurrentRiskCovenant?.EnemyLevelBonus ?? 0
                : 0));

        var team = EnemyTeamProvider.GetRandomTeam(
            teamSize,
            poolSize,
            firstStageOnly,
            unlocked,
            State.LegendaryUnlocked,
            State.CurrentRunLevel,
            State.CurrentRunDifficultyAdjustment);

        var usedItems = new HashSet<string>(StringComparer.Ordinal);
        bool unawareAlreadyChosen = false;
        EnemyLoadouts = team.Select(e =>
        {
            var moves = EnemyTeamProvider.PickProMoveset(e.Value);
            int skillAdjustment = State.CurrentRunDifficultyAdjustment;
            string ability = EnemyTeamProvider.PickProAbility(
                e.Value,
                moves,
                skillAdjustment,
                round: State.CurrentRunLevel,
                unawareAlreadyChosen: unawareAlreadyChosen);
            unawareAlreadyChosen |= ability == "천진";
            var availableItems = ItemDatabase.GetAvailableItems(e.Value.Name)
                .Where(item => item.Name == TeamLoadoutRules.NoItem || !usedItems.Contains(item.Name))
                .ToList();
            string item = EnemyTeamProvider.PickProItem(
                moves, availableItems, usedItems, skillAdjustment);
            if (item != TeamLoadoutRules.NoItem)
            {
                usedItems.Add(item);
            }

            return new PokemonLoadout
            {
                PokemonId = e.Key,
                ChosenMoveNames = moves,
                ChosenAbility = ability,
                ChosenItem = item,
                Level = enemyLevel
            };
        }).ToList();
        EnemyLoadouts = TeamLoadoutRules.NormalizeUniqueItems(EnemyLoadouts);
        await State.SetEnemyLoadouts(EnemyLoadouts);
    }

    private async Task ConfirmTeamAndGo()
    {
        await State.SetEnemyLoadouts(EnemyLoadouts);
        State.BeginBattle();

        if (State.PlayerLoadouts.Count == 0)
        {
            State.GoTo(GameScreen.TeamSelect);
            Nav.NavigateTo("/select");
        }
        else
        {
            Nav.NavigateTo("/continue");
        }
    }

    private async Task ChooseRisk(bool accept)
    {
        await State.ChooseRiskCovenantAsync(accept);
        EnemyLoadouts = State.EnemyLoadouts;
    }

    private List<PokemonLoadout> ApplyRiskBonus(List<PokemonLoadout> loadouts)
    {
        if (!State.RunMeta.RiskCovenantAccepted || State.CurrentRiskCovenant == null)
            return loadouts;

        foreach (var loadout in loadouts)
        {
            loadout.Level += State.CurrentRiskCovenant.EnemyLevelBonus;
        }
        return loadouts;
    }
}

@page "/admin"
@using PokemonBattle.Services
@inject CurrentUserService CurrentUser
@inject AdminDashboardService Dashboard
@inject NavigationManager Nav

<PageTitle>관리자 콘솔</PageTitle>

<main class="admin-page">
    @if (!CurrentUser.IsLoggedIn)
    {
        <section class="admin-empty">
            <h1>관리자 콘솔</h1>
            <p>로그인한 관리자만 접근할 수 있습니다.</p>
            <button type="button" @onclick="GoLogin">로그인 화면으로 이동</button>
        </section>
    }
    else if (!CurrentUser.IsAdmin)
    {
        <section class="admin-empty">
            <h1>접근 권한 없음</h1>
            <p>관리자 계정으로 로그인해야 이 화면을 볼 수 있습니다.</p>
            <button type="button" @onclick="GoHome">게임으로 돌아가기</button>
        </section>
    }
    else if (Snapshot == null)
    {
        <section class="admin-empty">
            <h1>관리자 콘솔</h1>
            <p>대시보드 데이터를 불러오는 중...</p>
        </section>
    }
    else
    {
        <header class="admin-header">
            <div>
                <p class="eyebrow">ADMIN / READ-ONLY DEBUG</p>
                <h1>관리자 콘솔</h1>
                <p>계정 진행 상황과 저장 데이터 무결성을 확인합니다.</p>
            </div>
            <button type="button" class="admin-refresh" @onclick="Refresh">새로고침</button>
        </header>

        <section class="admin-metric-grid" aria-label="서비스 요약">
            <article class="admin-metric"><span>전체 계정</span><strong>@Snapshot.UserCount</strong><small>관리자 @(Snapshot.AdminCount)명</small></article>
            <article class="admin-metric"><span>저장된 런</span><strong>@Snapshot.RunCount</strong><small>진행 상태 레코드</small></article>
            <article class="admin-metric"><span>프리셋</span><strong>@Snapshot.PresetCount</strong><small>사용자 팀 구성</small></article>
            <article class="admin-metric"><span>공통 데이터</span><strong>@Snapshot.KnownPokemonCount</strong><small>포켓몬 · 기술 @(Snapshot.KnownMoveCount)개</small></article>
        </section>

        <section class="admin-panel" aria-labelledby="user-overview-title">
            <div class="admin-panel-heading">
                <div>
                    <p class="eyebrow">PLAYER DATA</p>
                    <h2 id="user-overview-title">사용자 진행 현황</h2>
                </div>
                <span class="admin-generated">@Snapshot.GeneratedAtUtc.ToLocalTime().ToString("yyyy.MM.dd HH:mm") 갱신</span>
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>계정</th>
                            <th>현재 / 최고</th>
                            <th>전설 진행</th>
                            <th>해금</th>
                            <th>프리셋</th>
                            <th>출현 이력</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Snapshot.Users)
                        {
                            <tr>
                                <th scope="row">@user.Username @(user.IsAdmin ? "· 관리자" : "")</th>
                                <td>@user.CurrentScore / @user.HighScore</td>
                                <td><span class="admin-progress"><i style="width:@user.LegendaryProgressPercent%"></i></span> @user.LegendaryProgressPercent%</td>
                                <td>@user.UnlockedCount</td>
                                <td>@user.PresetCount</td>
                                <td>@user.LegendaryEncounterCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="admin-panel" aria-labelledby="debug-title">
            <div class="admin-panel-heading">
                <div>
                    <p class="eyebrow">DATA INTEGRITY</p>
                    <h2 id="debug-title">디버그 검사</h2>
                </div>
                <span class="admin-health @(Snapshot.IntegrityIssues.Count == 0 ? "is-ok" : "is-warning")">
                    @(Snapshot.IntegrityIssues.Count == 0 ? "정상" : $"{Snapshot.IntegrityIssues.Count}건 확인 필요")
                </span>
            </div>
            @if (Snapshot.IntegrityIssues.Count == 0)
            {
                <p class="admin-ok-message">저장된 런 JSON, 포켓몬 해금, 전설 이력에서 문제를 찾지 못했습니다.</p>
            }
            else
            {
                <ul class="admin-issues">
                    @foreach (var issue in Snapshot.IntegrityIssues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            }
        </section>

        <button type="button" class="admin-back" @onclick="GoHome">게임으로 돌아가기</button>
    }
</main>

@code {
    private AdminDashboardSnapshot? Snapshot;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.IsAdmin)
        {
            Snapshot = await Dashboard.LoadAsync();
        }
    }

    private async Task Refresh()
    {
        Snapshot = await Dashboard.LoadAsync();
    }

    private void GoLogin() => Nav.NavigateTo("/login");
    private void GoHome() => Nav.NavigateTo("/");
}
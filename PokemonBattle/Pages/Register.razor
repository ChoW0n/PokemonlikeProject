@page "/register"
@using PokemonBattle.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>회원가입</PageTitle>

    <main class="start-page auth-page">
    <h1>회원가입</h1>
        <p class="form-message" role="status" aria-live="polite">@Message</p>

        <form class="auth-form" @onsubmit="DoRegister" @onsubmit:preventDefault>
            <label for="register-username">아이디</label>
            <input id="register-username" class="dex-search" placeholder="아이디" autocomplete="username" required @bind-value="Username" @bind-value:event="oninput" />
            <label for="register-password">비밀번호</label>
            <input id="register-password" class="dex-search" placeholder="비밀번호 (6자 이상)" type="password" minlength="6" autocomplete="new-password" required @bind-value="Password" @bind-value:event="oninput" />

            <button type="submit" disabled="@IsSubmitting">@(IsSubmitting ? "가입 중..." : "가입하기")</button>
        </form>
    <button type="button" @onclick="GoLogin">이미 계정이 있어요</button>
</main>

@code {
    private string Username = "";
    private string Password = "";
    private string Message = "";
    private bool IsSubmitting;

    private async Task DoRegister()
    {
        if (IsSubmitting) return;
        if (string.IsNullOrWhiteSpace(Username))
        {
            Message = "아이디를 입력해주세요.";
            return;
        }
        if (Password.Length < 6)
        {
            Message = "비밀번호는 6자 이상 입력해주세요.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var (success, message) = await Auth.Register(Username, Password);
            Message = message;
            if (success)
            {
                Nav.NavigateTo("/login");
            }
        }
        catch
        {
            Message = "회원가입 중 문제가 발생했습니다. 잠시 후 다시 시도해주세요.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoLogin()
    {
        Nav.NavigateTo("/login");
    }
}

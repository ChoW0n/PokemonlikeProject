@page "/mailbox"
@using PokemonBattle.Data
@using PokemonBattle.Models
@using PokemonBattle.Services
@inject GameState State
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>메시지 보관함</PageTitle>

<main class="preview-page mailbox-page">
    <header class="page-header mailbox-header">
        <p class="eyebrow">INBOX / REWARDS</p>
        <h1>메시지 보관함</h1>
        <p class="intro">라이벌전 소식과 보상을 확인할 수 있습니다. 보관함을 열어도 모험 진행은 바뀌지 않습니다.</p>
    </header>

    <section class="info-panel" aria-labelledby="machine-heading">
        <h2 id="machine-heading">기술머신</h2>
        @if (State.TechnicalMachines.Count == 0)
        {
            <p>보유한 기술머신이 없습니다.</p>
        }
        else
        {
            <div class="move-chip-row" aria-label="보유 기술머신 목록">
                @foreach (var machine in State.TechnicalMachines.Where(item => item.Quantity > 0))
                {
                    <span class="move-chip">
                        TM · @(MoveDatabase.All.TryGetValue(machine.MoveKey, out var move) ? move.Name : machine.MoveKey)
                        ×@machine.Quantity
                    </span>
                }
            </div>
            <p class="config-label">기술머신을 배울 수 있는 포켓몬은 팀 편성 화면에서 기술 목록에 표시됩니다.</p>
        }
    </section>

    <section class="mailbox-section" aria-labelledby="message-heading">
        <div class="mailbox-section-heading">
            <div>
                <p class="eyebrow">MESSAGE ARCHIVE</p>
                <h2 id="message-heading">메시지</h2>
            </div>
            <span class="mailbox-unread-summary" aria-live="polite">
                <strong>@State.MailboxMessages.Count(message => !message.IsRead)</strong>개 읽지 않음
            </span>
        </div>
        @if (State.MailboxMessages.Count == 0)
        {
            <div class="mailbox-empty-state">
                <strong>보관함이 비어 있습니다</strong>
                <p>새로운 소식과 보상은 이곳에 도착합니다.</p>
            </div>
        }
        else
        {
            <div class="mailbox-actions">
                <span class="mailbox-action-note">읽지 않은 메시지를 한 번에 읽음 처리합니다.</span>
                <button type="button" class="mailbox-mark-all"
                        disabled="@(!State.MailboxMessages.Any(message => !message.IsRead))"
                        @onclick="MarkAllRead">전체 읽음</button>
            </div>
            <div class="preset-list" role="list" aria-label="보관함 메시지 목록">
                @foreach (var message in State.MailboxMessages)
                {
                    <article class="preset-entry mailbox-message @(message.IsRead ? "is-read" : "is-unread is-selected")" role="listitem">
                        <div class="mailbox-message-copy">
                            <div class="mailbox-message-heading">
                                <strong>@message.Title</strong>
                                <span class="mailbox-message-state @(message.IsRead ? "is-read" : "is-unread")">
                                    @(message.IsRead ? "읽음" : "새 메시지")
                                </span>
                            </div>
                            <p>@message.Body</p>
                            <small class="mailbox-message-date">@message.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                        @if (!message.IsRead)
                        {
                            <button type="button" class="mailbox-read-button"
                                    aria-label="@($"{message.Title} 읽음 처리")"
                                    @onclick="() => MarkRead(message.Id)">읽음</button>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <button type="button" @onclick="GoHome">시작 화면으로</button>
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await State.LoadRunForCurrentUser();
    }

    private async Task MarkRead(int messageId) =>
        await State.MarkMailboxMessageReadAsync(messageId);

    private async Task MarkAllRead() =>
        await State.MarkAllMailboxMessagesReadAsync();

    private void GoHome() => Nav.NavigateTo("/");
}
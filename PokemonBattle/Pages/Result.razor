@page "/result"
@using PokemonBattle.Services
@using PokemonBattle.Models
@inject GameState State
@inject UnlockService Unlocks
@inject NavigationManager Nav

<PageTitle>배틀 결과</PageTitle>

<main class="result-page">
    <p class="eyebrow result-kicker">BATTLE REPORT / RUN STATUS</p>
    <p class="result-context">이번 전투가 끝났습니다. 보상과 다음 행동을 확인하세요.</p>
    <section class="result-skill-summary" aria-label="실력 평점 결과">
        <h2>실력 평점</h2>
        <p>
            현재 평점:
            <strong>@State.ResultSkillRating.ToString("0")</strong>
            <span class="rating-change @(State.LastSkillRatingChange >= 0 ? "is-positive" : "is-negative")">
                (@RatingChangeText(State.LastSkillRatingChange))
            </span>
        </p>
        <p>다음 런 상대 레벨 보정: <strong>@DifficultyText(State.NextRunDifficultyAdjustment)</strong></p>
        @if (State.HasPendingSkillRatingUpdate)
        {
            <small>이번 승리의 평점은 새 런을 시작할 때 확정됩니다.</small>
        }
    </section>

    @if (State.LastBattleWon)
    {
        <h1 class="result-win">승리!</h1>
        @if (State.IsRivalBattle)
        {
            <p class="config-label">라이벌전 승리! 보관함에 기술머신 1개를 지급했습니다.</p>
        }
        <p>현재 연승 점수: @State.CurrentScore</p>
        <p>최고 기록: @State.HighScore</p>
        <p class="config-label">전설 출현 진행도: @State.LegendaryProgressPercent%</p>
        @if (State.LastLegendaryProgressReward > 0)
        {
            <p class="config-label">이번 클리어 보상: +@State.LastLegendaryProgressReward%</p>
        }
        @if (State.LegendaryEncounterConsumed)
        {
            <p class="config-label">전설 출현을 소비했습니다. 현재 진행도 0%에서 다음 주기를 시작합니다.</p>
        }
        else if (State.LegendaryUnlocked)
        {
            <p class="config-label">전설 포켓몬이 다음 상대 후보에 등장할 수 있습니다!</p>
        }

        @if (State.EvolutionMessages.Count > 0)
        {
            <p class="config-label">새로운 진화형 해금: @string.Join(", ", State.EvolutionMessages)</p>
        }

        @if (State.PendingLegacyChoices.Count > 0 && State.LegacyClaimsRemaining > 0)
        {
            <section class="info-panel" aria-label="관록의 유산 선택">
                <strong>관록의 유산 선택 · @(State.LegacyClaimsRemaining)개 남음</strong>
                <p class="info-desc">이번 런 동안 유지됩니다. 선택하지 않고 계속하면 후보가 사라집니다.</p>
                <div class="enemy-grid" role="list" aria-label="관록의 유산 후보">
                    @foreach (var legacyId in State.PendingLegacyChoices)
                    {
                        var legacy = RunMetaCatalog.Legacy(legacyId);
                        if (legacy == null) continue;
                        <article class="enemy-card" role="listitem">
                                <button type="button" class="enemy-card-toggle" disabled="@IsSubmitting" @onclick="() => ClaimLegacy(legacy.Id)">
                                <span class="enemy-card-title">@legacy.Name</span>
                                <span class="enemy-card-status">@legacy.Description</span>
                            </button>
                        </article>
                    }
                </div>
            </section>
        }
        @if (State.ActiveLegacies.Count > 0)
        {
            <p class="config-label">현재 관록: @string.Join(" · ", State.ActiveLegacies.Select(legacy => legacy.Name))</p>
        }

        @if (State.PendingStolenMoveChoices.Count > 0)
        {
            <section class="info-panel" aria-label="기술 강탈">
                <strong>기술 강탈</strong>
                <p class="info-desc">실제로 사용된 상대 기술 중 하나를 현재 팀 포켓몬에게 배웁니다. 기술 칸이 가득 찼다면 교체할 기존 기술도 선택하세요.</p>
                <div class="move-chip-row">
                    @foreach (var option in State.PendingStolenMoveChoices)
                    {
                        var move = MoveDatabase.All[option.MoveKey];
                        <button type="button" class="move-chip @(SelectedStolenMoveKey == option.MoveKey ? "is-selected" : "")"
                                @onclick="() => SelectedStolenMoveKey = option.MoveKey">
                            @move.Name · @PokemonDatabase.All[option.SourcePokemonId].Name
                        </button>
                    }
                </div>
                @if (State.PlayerLoadouts.Count == 0)
                {
                    <p class="form-message" role="status">선택 가능한 포켓몬이 없습니다.</p>
                }
                else
                {
                    <div class="enemy-grid" role="list" aria-label="기술을 배울 포켓몬">
                    @foreach (var loadout in State.PlayerLoadouts)
                    {
                        var data = PokemonDatabase.All[loadout.PokemonId];
                        <article class="enemy-card @(SelectedStolenTargetId == loadout.PokemonId ? "is-selected" : "")" role="listitem">
                            <button type="button" class="enemy-card-toggle"
                                    @onclick="() => SelectStolenTarget(loadout.PokemonId)">
                                <img src="@data.EffectiveImageUrl" alt="" class="enemy-sprite" />
                                <span class="enemy-card-title">@data.Name</span>
                                <span class="enemy-card-status">@loadout.ChosenMoveNames.Count / 4 기술 · @(loadout.ChosenMoveNames.Count >= 4 ? "교체 가능" : "빈 슬롯")</span>
                            </button>
                        </article>
                    }
                    </div>
                }
                @if (SelectedStolenTargetId is int targetId)
                {
                    var targetLoadout = State.PlayerLoadouts.FirstOrDefault(loadout => loadout.PokemonId == targetId);
                    if (targetLoadout?.ChosenMoveNames.Count >= 4)
                    {
                        <div class="info-panel stolen-replacement-panel" aria-label="교체할 기존 기술">
                            <strong>교체할 기존 기술 선택</strong>
                            <p class="info-desc">새 기술을 넣을 자리를 선택합니다. 강탈 기술은 기존 기술을 덮어씁니다.</p>
                            <div class="move-chip-row">
                                @foreach (var existingMoveKey in targetLoadout.ChosenMoveNames)
                                {
                                    if (!MoveDatabase.All.TryGetValue(existingMoveKey, out var existingMove)) continue;
                                    <button type="button"
                                            class="move-chip @(SelectedStolenReplacementKey == existingMoveKey ? "is-selected" : "")"
                                            @onclick="() => SelectedStolenReplacementKey = existingMoveKey">
                                        @existingMove.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
                <button type="button" disabled="@(!CanClaimStolenMove || IsSubmitting)"
                        @onclick="ClaimStolenMove">선택한 기술 강탈</button>
                <p class="form-message" role="status">@StolenMoveMessage</p>
            </section>
        }

        <LegendaryHistory />

        @if (Candidates.Count > 0 && !Claimed)
        {
            <p class="config-label">쓰러뜨린 상대 중 1마리를 데려갈 수 있습니다 (선택은 자유입니다)</p>
            <div class="enemy-grid" role="list" aria-label="포획 후보 포켓몬">
                @foreach (var candidate in Candidates)
                {
                    bool owned = OwnedIds.Contains(candidate.Key);
                    bool inCurrentTeam = State.PlayerLoadouts.Any(loadout => loadout.PokemonId == candidate.Key);
                    string candidateStatus = owned
                        ? (inCurrentTeam
                            ? "보유 중 · 선택 시 추가 레벨"
                            : "보유 중(이번 팀엔 없음) · 선택해도 효과 없음")
                        : "미보유 · 선택 시 해금";
                    <article class="enemy-card @(SelectedCatchId == candidate.Key ? "is-selected" : string.Empty)" role="listitem">
                        <button type="button" class="enemy-card-toggle" aria-label="@($"{candidate.Value.Name}, {candidateStatus}")" aria-pressed="@(SelectedCatchId == candidate.Key ? "true" : "false")" title="두 번 클릭하면 바로 등록합니다." @onclick="() => SelectedCatchId = candidate.Key" @ondblclick="ClaimPokemon" @ondblclick:preventDefault>
                            <img src="@candidate.Value.EffectiveImageUrl" alt="" class="enemy-sprite" />
                            <span class="enemy-card-title">@candidate.Value.Name</span>
                            <span class="enemy-card-status">@candidateStatus</span>
                        </button>
                    </article>
                }
            </div>
            <button type="button" disabled="@(SelectedCatchId == null || IsSubmitting)" @onclick="ClaimPokemon">@(IsSubmitting ? "처리 중..." : "이 포켓몬 데려가기")</button>
        }
        else if (Claimed)
        {
            <p>@ClaimMessage</p>
        }

        <div class="result-primary-actions">
            <span class="result-next-label">NEXT STAGE</span>
            <button type="button" disabled="@IsSubmitting" @onclick="NextRound">다음 상대와 계속하기</button>
        </div>
        <details class="result-secondary-actions">
            <summary>추가 메뉴</summary>
            <button type="button" disabled="@IsSubmitting" @onclick="RestartGame">새 런 시작</button>
        </details>
    }
    else
    {
        <h1 class="result-lose">패배...</h1>
        @if (State.IsRivalBattle)
        {
            <p class="config-label">라이벌전에서 패배했습니다. 결과 메시지를 보관함에 보관했습니다.</p>
        }
        <p>이번 판 점수: 0으로 초기화됨</p>
        <p>최고 기록: @State.HighScore</p>
        <p class="config-label">전설 출현 진행도: @State.LegendaryProgressPercent%</p>
        @if (State.LegendaryEncounterConsumed)
        {
            <p class="config-label">전설 출현을 소비했습니다. 현재 진행도 0%에서 다음 주기를 시작합니다.</p>
        }
        <LegendaryHistory />
        <button type="button" disabled="@IsSubmitting" @onclick="RestartGame">처음부터 다시 시작</button>
    }

</main>

@code {
    private List<KeyValuePair<int, PokemonData>> Candidates = new();
    private HashSet<int> OwnedIds = new();
    private int? SelectedCatchId;
    private bool Claimed;
    private string ClaimMessage = "";
    private string? SelectedStolenMoveKey;
    private int? SelectedStolenTargetId;
    private string? SelectedStolenReplacementKey;
    private string StolenMoveMessage = "";
    private bool IsSubmitting;

    private bool CanClaimStolenMove
    {
        get
        {
            if (SelectedStolenMoveKey == null || SelectedStolenTargetId == null) return false;
            var target = State.PlayerLoadouts.FirstOrDefault(loadout =>
                loadout.PokemonId == SelectedStolenTargetId.Value);
            return target != null
                && (target.ChosenMoveNames.Count < 4
                    || (SelectedStolenReplacementKey != null
                        && target.ChosenMoveNames.Contains(SelectedStolenReplacementKey)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!State.LastBattleWon) return;

        OwnedIds = await Unlocks.GetUnlockedIds();

        //상대 팀 전체가 후보. 보유 여부와 무관하게 다 보여주고, 선택은 순전히 유저 자유
        Candidates = State.EnemyTeamIds
            .Distinct()
            .Select(id => new KeyValuePair<int, PokemonData>(id, PokemonDatabase.All[id]))
            .ToList();
    }

    private async Task ClaimPokemon()
    {
        if (IsSubmitting || SelectedCatchId == null) return;

        IsSubmitting = true;
        int id = SelectedCatchId.Value;
        try
        {
            if (OwnedIds.Contains(id))
            {
                //이미 보유한 포켓몬: 지금 팀에 있으면 추가 레벨 지급, 없으면 안내만
                var teammate = State.PlayerLoadouts.FirstOrDefault(l => l.PokemonId == id);
                if (teammate != null)
                {
                    teammate.Level++;
                    ClaimMessage = $"{PokemonDatabase.All[id].Name}이(가) 추가 레벨을 얻었습니다! (Lv.{teammate.Level})";
                }
                else
                {
                    ClaimMessage = $"{PokemonDatabase.All[id].Name}은(는) 이미 보유 중입니다. (현재 팀에는 없어 효과 없음)";
                }
            }
            else
            {
                await Unlocks.Unlock(id);
                OwnedIds.Add(id);
                ClaimMessage = $"{PokemonDatabase.All[id].Name}을(를) 새로 해금했습니다!";
            }

            Claimed = true;
        }
        catch
        {
            ClaimMessage = "보상 저장 중 문제가 발생했습니다. 다시 시도해주세요.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ClaimLegacy(string legacyId)
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        try
        {
            await State.ClaimLegacyAsync(legacyId);
        }
        catch
        {
            StolenMoveMessage = "보상 저장 중 문제가 발생했습니다. 다시 시도해주세요.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ClaimStolenMove()
    {
        if (IsSubmitting || SelectedStolenTargetId == null || SelectedStolenMoveKey == null) return;

        IsSubmitting = true;
        try
        {
            bool claimed = await State.ClaimStolenMoveAsync(
                SelectedStolenTargetId.Value,
                SelectedStolenMoveKey,
                SelectedStolenReplacementKey);
            StolenMoveMessage = claimed
                ? "기술을 이번 런의 팀에 추가했습니다."
                : "대상이 이미 배운 기술이거나 교체할 기술을 선택하지 않았습니다.";
            if (claimed)
            {
                SelectedStolenMoveKey = null;
                SelectedStolenTargetId = null;
                SelectedStolenReplacementKey = null;
            }
        }
        catch
        {
            StolenMoveMessage = "보상 저장 중 문제가 발생했습니다. 다시 시도해주세요.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void SelectStolenTarget(int pokemonId)
    {
        SelectedStolenTargetId = pokemonId;
        SelectedStolenReplacementKey = null;
    }

    private async Task NextRound() //선택 여부와 무관하게 항상 작동
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        try
        {
            await State.ClearPendingRunRewardsAsync();
            State.GoTo(GameScreen.EnemyPreview);
            Nav.NavigateTo("/preview");
        }
        catch
        {
            StolenMoveMessage = "다음 라운드를 준비하지 못했습니다. 다시 시도해주세요.";
            IsSubmitting = false;
        }
    }

    private async Task RestartGame()
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        try
        {
            await State.ResetForNewRun();
            Nav.NavigateTo("/starter");
        }
        catch
        {
            StolenMoveMessage = "새 런을 준비하지 못했습니다. 다시 시도해주세요.";
            IsSubmitting = false;
        }
    }

    private static string RatingChangeText(double change) =>
        change >= 0 ? $"+{change:0}" : change.ToString("0");

    private static string DifficultyText(int adjustment) =>
        adjustment == 0
            ? "기본 레벨과 동일"
            : adjustment > 0
                ? $"기본 레벨 +{adjustment}"
                : $"기본 레벨 {adjustment}";

}